<%- include('partials/header') %>

<!-- Flash -->
<% if(typeof success !== 'undefined' && success && success.length){ %>
  <div class="alert alert-success alert-dismissible fade show" role="alert">
    <i class="bi bi-check-circle-fill me-2"></i><%= success %>
    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
  </div>
<% } %>

<!-- Stat Cards -->
<div class="row g-3 mb-4">
  <div class="col-6 col-lg-3">
    <div class="stat-card border-0 shadow-sm" style="background:linear-gradient(135deg,#6c47ff,#a855f7)">
      <div class="d-flex justify-content-between align-items-center">
        <div>
          <p class="text-white-50 mb-1 small fw-medium">Total Users</p>
          <h3 class="text-white mb-0 fw-bold"><%= totalUsers %></h3>
        </div>
        <i class="bi bi-people-fill text-white-50" style="font-size:2rem;"></i>
      </div>
    </div>
  </div>
  <div class="col-6 col-lg-3">
    <div class="stat-card border-0 shadow-sm" style="background:linear-gradient(135deg,#f59e0b,#ef4444)">
      <div class="d-flex justify-content-between align-items-center">
        <div>
          <p class="text-white-50 mb-1 small fw-medium">Total Vendors</p>
          <h3 class="text-white mb-0 fw-bold"><%= totalVendors %></h3>
        </div>
        <i class="bi bi-shop text-white-50" style="font-size:2rem;"></i>
      </div>
    </div>
  </div>
  <div class="col-6 col-lg-3">
    <div class="stat-card border-0 shadow-sm" style="background:linear-gradient(135deg,#10b981,#059669)">
      <div class="d-flex justify-content-between align-items-center">
        <div>
          <p class="text-white-50 mb-1 small fw-medium">Total Bookings</p>
          <h3 class="text-white mb-0 fw-bold"><%= totalBookings %></h3>
        </div>
        <i class="bi bi-calendar-check-fill text-white-50" style="font-size:2rem;"></i>
      </div>
    </div>
  </div>
  <div class="col-6 col-lg-3">
    <div class="stat-card border-0 shadow-sm" style="background:linear-gradient(135deg,#3b82f6,#1d4ed8)">
      <div class="d-flex justify-content-between align-items-center">
        <div>
          <p class="text-white-50 mb-1 small fw-medium">Total Revenue</p>
          <h3 class="text-white mb-0 fw-bold">₹<%= parseFloat(totalRevenue).toFixed(0) %></h3>
        </div>
        <i class="bi bi-currency-rupee text-white-50" style="font-size:2rem;"></i>
      </div>
    </div>
  </div>
</div>

<!-- Revenue Breakdown -->
<div class="row g-3 mb-4">
  <div class="col-md-4">
    <div class="card h-100 border-0 shadow-sm">
      <div class="card-body text-center py-4">
        <div class="mb-3">
          <i class="bi bi-graph-up-arrow text-success" style="font-size:2.5rem;"></i>
        </div>
        <h4 class="mb-1 fw-bold text-success">₹<%= parseFloat(totalRevenue).toFixed(2) %></h4>
        <p class="text-muted small mb-0">Total Platform Revenue</p>
      </div>
    </div>
  </div>
  <div class="col-md-4">
    <div class="card h-100 border-0 shadow-sm">
      <div class="card-body text-center py-4">
        <div class="mb-3">
          <i class="bi bi-credit-card text-primary" style="font-size:2.5rem;"></i>
        </div>
        <h4 class="mb-1 fw-bold text-primary">₹<%= parseFloat(platformRevenue).toFixed(2) %></h4>
        <p class="text-muted small mb-0">Platform Charges Collected</p>
      </div>
    </div>
  </div>
  <div class="col-md-4">
    <div class="card h-100 border-0 shadow-sm">
      <div class="card-body text-center py-4">
        <div class="mb-3">
          <i class="bi bi-receipt text-warning" style="font-size:2.5rem;"></i>
        </div>
        <h4 class="mb-1 fw-bold text-warning">₹<%= parseFloat(gstCollected).toFixed(2) %></h4>
        <p class="text-muted small mb-0">GST Collected</p>
      </div>
    </div>
  </div>
</div>

<!-- Alerts Row -->
<div class="row g-3 mb-4">
  <div class="col-md-6">
    <div class="card border-0 shadow-sm border-start border-warning border-4">
      <div class="card-body d-flex align-items-center gap-3">
        <div class="p-3 bg-warning bg-opacity-10 rounded-circle">
          <i class="bi bi-clock-history text-warning" style="font-size:1.5rem;"></i>
        </div>
        <div class="flex-grow-1">
          <h4 class="mb-0 fw-bold text-dark"><%= pendingKyc %></h4>
          <p class="mb-0 text-muted small">KYC Applications Pending Review</p>
        </div>
        <a href="/admin/vendors?status=pending_kyc" class="btn btn-warning btn-sm">
          <i class="bi bi-arrow-right"></i>
        </a>
      </div>
    </div>
  </div>
  <div class="col-md-6">
    <div class="card border-0 shadow-sm border-start border-info border-4">
      <div class="card-body d-flex align-items-center gap-3">
        <div class="p-3 bg-info bg-opacity-10 rounded-circle">
          <i class="bi bi-clipboard-check text-info" style="font-size:1.5rem;"></i>
        </div>
        <div class="flex-grow-1">
          <h4 class="mb-0 fw-bold text-dark"><%= pendingBookings %></h4>
          <p class="mb-0 text-muted small">Bookings Awaiting Action</p>
        </div>
        <a href="/admin/bookings?status=pending" class="btn btn-info btn-sm text-white">
          <i class="bi bi-arrow-right"></i>
        </a>
      </div>
    </div>
  </div>
</div>

<!-- Charts -->
<div class="row g-3 mb-4">
  <div class="col-lg-8">
    <div class="card border-0 shadow-sm">
      <div class="card-header bg-white border-bottom d-flex justify-content-between align-items-center">
        <h6 class="mb-0 fw-semibold text-dark"><i class="bi bi-graph-up me-2 text-primary"></i>Bookings & Revenue — Last 6 Months</h6>
        <div class="d-flex gap-2">
          <span class="d-flex align-items-center gap-1" style="font-size:.75rem;color:#6c47ff;"><span style="width:10px;height:10px;border-radius:50%;background:#6c47ff;display:inline-block;"></span>Bookings</span>
          <span class="d-flex align-items-center gap-1" style="font-size:.75rem;color:#10b981;"><span style="width:10px;height:10px;border-radius:50%;background:#10b981;display:inline-block;"></span>Revenue</span>
        </div>
      </div>
      <div class="card-body" style="padding:20px;">
        <canvas id="trendChart" height="100"></canvas>
      </div>
    </div>
  </div>
  <div class="col-lg-4">
    <div class="card border-0 shadow-sm h-100">
      <div class="card-header bg-white border-bottom">
        <h6 class="mb-0 fw-semibold text-dark"><i class="bi bi-pie-chart me-2 text-primary"></i>Booking Status</h6>
      </div>
      <div class="card-body d-flex flex-column align-items-center justify-content-center">
        <canvas id="statusChart" height="180"></canvas>
        <div class="mt-3 w-100" id="statusLegend"></div>
      </div>
    </div>
  </div>
</div>

<!-- Recent Tables -->
<div class="row g-3 mb-4">
  <div class="col-lg-7">
    <div class="card border-0 shadow-sm">
      <div class="card-header bg-white border-bottom d-flex justify-content-between align-items-center">
        <h6 class="mb-0 fw-semibold text-dark">
          <i class="bi bi-calendar-event me-2 text-primary"></i>Recent Bookings
        </h6>
        <a href="/admin/bookings" class="btn btn-sm btn-outline-primary">
          <i class="bi bi-arrow-right me-1"></i>View All
        </a>
      </div>
      <div class="table-responsive">
        <table class="table table-hover mb-0">
          <thead class="table-light">
            <tr><th>User</th><th>Service</th><th>Amount</th><th>Status</th></tr>
          </thead>
          <tbody>
          <% recentBookings.forEach(b => { %>
            <tr>
              <td>
                <div class="d-flex align-items-center gap-2">
                  <div class="bg-primary bg-opacity-10 rounded-circle p-2">
                    <i class="bi bi-person-fill text-primary" style="font-size:12px;"></i>
                  </div>
                  <div>
                    <div class="fw-medium"><%= b.User?.name || '—' %></div>
                    <small class="text-muted"><%= b.User?.mobile %></small>
                  </div>
                </div>
              </td>
              <td><%= b.Service?.name || '—' %></td>
              <td class="fw-semibold">₹<%= parseFloat(b.total_amount||b.amount||0).toFixed(0) %></td>
              <td>
                <% const sc={pending:'warning',accepted:'info',in_progress:'primary',completed:'success',cancelled:'danger'}; %>
                <span class="badge bg-<%= sc[b.status]||'secondary' %> rounded-pill"><%= b.status %></span>
              </td>
            </tr>
          <% }) %>
          <% if(!recentBookings.length){ %>
            <tr><td colspan="4" class="text-center text-muted py-4">No bookings yet</td></tr>
          <% } %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
  <div class="col-lg-5">
    <div class="card border-0 shadow-sm">
      <div class="card-header bg-white border-bottom d-flex justify-content-between align-items-center">
        <h6 class="mb-0 fw-semibold text-dark">
          <i class="bi bi-shop me-2 text-primary"></i>Recent Vendors
        </h6>
        <a href="/admin/vendors" class="btn btn-sm btn-outline-primary">
          <i class="bi bi-arrow-right me-1"></i>View All
        </a>
      </div>
      <div class="table-responsive">
        <table class="table table-hover mb-0">
          <thead class="table-light">
            <tr><th>Vendor</th><th>KYC Status</th></tr>
          </thead>
          <tbody>
          <% recentVendors.forEach(v => { %>
            <tr>
              <td>
                <div class="d-flex align-items-center gap-2">
                  <div class="bg-warning bg-opacity-10 rounded-circle p-2">
                    <i class="bi bi-shop text-warning" style="font-size:12px;"></i>
                  </div>
                  <div>
                    <a href="/admin/vendors/<%= v.id %>" class="text-decoration-none fw-semibold text-dark">
                      <%= v.business_name||'—' %>
                    </a>
                    <br><small class="text-muted"><%= v.User?.mobile %></small>
                  </div>
                </div>
              </td>
              <td>
                <% const kc={pending:'secondary',under_review:'warning',approved:'success',rejected:'danger'}; %>
                <span class="badge bg-<%= kc[v.kyc_status] %> rounded-pill"><%= v.kyc_status %></span>
              </td>
            </tr>
          <% }) %>
          <% if(!recentVendors.length){ %>
            <tr><td colspan="2" class="text-center text-muted py-4">No vendors yet</td></tr>
          <% } %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
<script>
  // ── Trend Chart (Line) ────────────────────────────────────────────────────
  const trendCtx = document.getElementById('trendChart').getContext('2d');
  const monthLabels  = <%- JSON.stringify(monthLabels) %>;
  const monthCounts  = <%- JSON.stringify(monthCounts) %>;
  const monthRevenue = <%- JSON.stringify(monthRevenue) %>;

  new Chart(trendCtx, {
    type: 'line',
    data: {
      labels: monthLabels,
      datasets: [
        {
          label: 'Bookings',
          data: monthCounts,
          borderColor: '#6c47ff',
          backgroundColor: 'rgba(108,71,255,.08)',
          borderWidth: 2.5,
          pointBackgroundColor: '#6c47ff',
          pointRadius: 4,
          pointHoverRadius: 6,
          tension: 0.4,
          fill: true,
          yAxisID: 'y',
        },
        {
          label: 'Revenue (₹)',
          data: monthRevenue,
          borderColor: '#10b981',
          backgroundColor: 'rgba(16,185,129,.06)',
          borderWidth: 2.5,
          pointBackgroundColor: '#10b981',
          pointRadius: 4,
          pointHoverRadius: 6,
          tension: 0.4,
          fill: true,
          yAxisID: 'y1',
        },
      ],
    },
    options: {
      responsive: true,
      interaction: { mode: 'index', intersect: false },
      plugins: {
        legend: { display: false },
        tooltip: {
          backgroundColor: '#1a1a2e',
          titleColor: '#fff',
          bodyColor: '#ccc',
          padding: 12,
          cornerRadius: 10,
          callbacks: {
            label: ctx => ctx.datasetIndex === 1
              ? ` ₹${Number(ctx.raw).toLocaleString('en-IN')}`
              : ` ${ctx.raw} bookings`,
          },
        },
      },
      scales: {
        x: { grid: { display: false }, ticks: { font: { size: 11 } } },
        y:  { position: 'left',  grid: { color: '#f0f0f8' }, ticks: { font: { size: 11 }, stepSize: 1 }, title: { display: true, text: 'Bookings', font: { size: 10 } } },
        y1: { position: 'right', grid: { drawOnChartArea: false }, ticks: { font: { size: 11 }, callback: v => '₹'+v }, title: { display: true, text: 'Revenue', font: { size: 10 } } },
      },
    },
  });

  // ── Status Doughnut ───────────────────────────────────────────────────────
  const statusCtx = document.getElementById('statusChart').getContext('2d');
  const statusLabels = <%- JSON.stringify(statusLabels) %>;
  const statusCounts = <%- JSON.stringify(statusCounts) %>;
  const statusColors = { pending:'#f59e0b', accepted:'#06b6d4', in_progress:'#6c47ff', completed:'#10b981', cancelled:'#ef4444' };
  const colors = statusLabels.map(l => statusColors[l] || '#94a3b8');

  new Chart(statusCtx, {
    type: 'doughnut',
    data: {
      labels: statusLabels,
      datasets: [{ data: statusCounts, backgroundColor: colors, borderWidth: 0, hoverOffset: 6 }],
    },
    options: {
      cutout: '72%',
      responsive: true,
      plugins: {
        legend: { display: false },
        tooltip: {
          backgroundColor: '#1a1a2e',
          titleColor: '#fff',
          bodyColor: '#ccc',
          padding: 10,
          cornerRadius: 10,
        },
      },
    },
  });

  // Custom legend
  const total = statusCounts.reduce((a,b) => a+b, 0);
  document.getElementById('statusLegend').innerHTML = statusLabels.map((l,i) =>
    `<div class="d-flex justify-content-between align-items-center mb-1">
      <div class="d-flex align-items-center gap-2">
        <span style="width:10px;height:10px;border-radius:50%;background:${colors[i]};display:inline-block;flex-shrink:0;"></span>
        <span style="font-size:.78rem;text-transform:capitalize;">${l.replace('_',' ')}</span>
      </div>
      <span style="font-size:.78rem;font-weight:600;">${statusCounts[i]} <span style="color:#aaa;font-weight:400;">(${total?Math.round(statusCounts[i]/total*100):0}%)</span></span>
    </div>`
  ).join('');
</script>

<%- include('partials/footer') %>
