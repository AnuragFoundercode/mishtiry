<%- include('partials/header') %>

<!-- Today Highlight -->
<div class="d-flex align-items-center justify-content-between mb-4">
  <div>
    <h4 class="fw-bold mb-0">Dashboard</h4>
    <small class="text-muted"><%= new Date().toLocaleDateString('en-IN', { weekday:'long', day:'2-digit', month:'long', year:'numeric' }) %></small>
  </div>
  <div class="d-flex gap-2">
    <div class="badge bg-success bg-opacity-10 text-success px-3 py-2" style="font-size:.8rem;">
      <i class="bi bi-circle-fill me-1" style="font-size:6px;"></i><%= onlineWorkers %> Workers Online
    </div>
    <% if(pendingWorkers > 0){ %>
    <a href="/admin/workers?status=pending" class="badge bg-warning bg-opacity-10 text-warning px-3 py-2 text-decoration-none" style="font-size:.8rem;">
      <i class="bi bi-exclamation-circle me-1"></i><%= pendingWorkers %> Pending Approval
    </a>
    <% } %>
  </div>
</div>

<!-- Row 1: Key Metrics -->
<div class="row g-3 mb-4">
  <div class="col-6 col-lg-3">
    <div class="card border-0 shadow-sm h-100">
      <div class="card-body p-3 d-flex align-items-center gap-3">
        <div class="rounded-3 d-flex align-items-center justify-content-center flex-shrink-0" style="width:46px;height:46px;background:linear-gradient(135deg,#6c47ff,#a855f7);">
          <i class="bi bi-currency-rupee text-white"></i>
        </div>
        <div>
          <div class="fw-bold fs-5">₹<%= parseFloat(totalRevenue).toFixed(0) %></div>
          <small class="text-muted" style="font-size:.7rem;">TOTAL REVENUE</small>
        </div>
      </div>
    </div>
  </div>
  <div class="col-6 col-lg-3">
    <div class="card border-0 shadow-sm h-100">
      <div class="card-body p-3 d-flex align-items-center gap-3">
        <div class="rounded-3 d-flex align-items-center justify-content-center flex-shrink-0" style="width:46px;height:46px;background:linear-gradient(135deg,#22c55e,#16a34a);">
          <i class="bi bi-graph-up text-white"></i>
        </div>
        <div>
          <div class="fw-bold fs-5">₹<%= parseFloat(todayRevenue).toFixed(0) %></div>
          <small class="text-muted" style="font-size:.7rem;">TODAY'S REVENUE</small>
        </div>
      </div>
    </div>
  </div>
  <div class="col-6 col-lg-3">
    <div class="card border-0 shadow-sm h-100">
      <div class="card-body p-3 d-flex align-items-center gap-3">
        <div class="rounded-3 d-flex align-items-center justify-content-center flex-shrink-0" style="width:46px;height:46px;background:linear-gradient(135deg,#f59e0b,#d97706);">
          <i class="bi bi-receipt text-white"></i>
        </div>
        <div>
          <div class="fw-bold fs-5">₹<%= parseFloat(platformRevenue + gstCollected).toFixed(0) %></div>
          <small class="text-muted" style="font-size:.7rem;">PLATFORM EARNINGS</small>
        </div>
      </div>
    </div>
  </div>
  <div class="col-6 col-lg-3">
    <div class="card border-0 shadow-sm h-100">
      <div class="card-body p-3 d-flex align-items-center gap-3">
        <div class="rounded-3 d-flex align-items-center justify-content-center flex-shrink-0" style="width:46px;height:46px;background:linear-gradient(135deg,#3b82f6,#1d4ed8);">
          <i class="bi bi-calendar-check text-white"></i>
        </div>
        <div>
          <div class="fw-bold fs-5"><%= todayBookings %></div>
          <small class="text-muted" style="font-size:.7rem;">TODAY'S BOOKINGS</small>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Row 2: People + Booking Stats -->
<div class="row g-3 mb-4">
  <div class="col-4 col-lg-2">
    <div class="card border-0 shadow-sm text-center p-3">
      <div class="fw-bold fs-5 text-primary"><%= totalUsers %></div>
      <small class="text-muted" style="font-size:.65rem;">USERS</small>
    </div>
  </div>
  <div class="col-4 col-lg-2">
    <div class="card border-0 shadow-sm text-center p-3">
      <div class="fw-bold fs-5 text-warning"><%= totalWorkers %></div>
      <small class="text-muted" style="font-size:.65rem;">WORKERS</small>
    </div>
  </div>
  <div class="col-4 col-lg-2">
    <div class="card border-0 shadow-sm text-center p-3">
      <div class="fw-bold fs-5"><%= totalBookings %></div>
      <small class="text-muted" style="font-size:.65rem;">TOTAL BOOKINGS</small>
    </div>
  </div>
  <div class="col-4 col-lg-2">
    <div class="card border-0 shadow-sm text-center p-3">
      <div class="fw-bold fs-5 text-warning"><%= pendingBookings %></div>
      <small class="text-muted" style="font-size:.65rem;">PENDING</small>
    </div>
  </div>
  <div class="col-4 col-lg-2">
    <div class="card border-0 shadow-sm text-center p-3">
      <div class="fw-bold fs-5 text-success"><%= completedBookings %></div>
      <small class="text-muted" style="font-size:.65rem;">COMPLETED</small>
    </div>
  </div>
  <div class="col-4 col-lg-2">
    <div class="card border-0 shadow-sm text-center p-3">
      <div class="fw-bold fs-5 text-danger"><%= cancelledBookings %></div>
      <small class="text-muted" style="font-size:.65rem;">CANCELLED</small>
    </div>
  </div>
</div>

<!-- Row 3: Charts -->
<div class="row g-3 mb-4">
  <div class="col-lg-8">
    <div class="card border-0 shadow-sm">
      <div class="card-header bg-white border-bottom py-3">
        <div class="d-flex justify-content-between align-items-center">
          <h6 class="mb-0 fw-semibold"><i class="bi bi-bar-chart me-2 text-primary"></i>Revenue & Bookings (6 Months)</h6>
        </div>
      </div>
      <div class="card-body">
        <canvas id="revenueChart" height="200"></canvas>
      </div>
    </div>
  </div>
  <div class="col-lg-4">
    <div class="card border-0 shadow-sm h-100">
      <div class="card-header bg-white border-bottom py-3">
        <h6 class="mb-0 fw-semibold"><i class="bi bi-pie-chart me-2 text-primary"></i>Booking Status</h6>
      </div>
      <div class="card-body d-flex align-items-center justify-content-center">
        <canvas id="statusChart" height="200"></canvas>
      </div>
    </div>
  </div>
</div>

<!-- Row 4: Recent Tables -->
<div class="row g-3">
  <!-- Recent Bookings -->
  <div class="col-lg-8">
    <div class="card border-0 shadow-sm">
      <div class="card-header bg-white border-bottom py-3 d-flex justify-content-between align-items-center">
        <h6 class="mb-0 fw-semibold"><i class="bi bi-calendar-check me-2 text-primary"></i>Recent Bookings</h6>
        <a href="/admin/bookings" class="btn btn-sm btn-outline-primary">View All</a>
      </div>
      <div class="table-responsive">
        <table class="table table-hover mb-0" style="font-size:.8rem;">
          <thead class="table-light">
            <tr><th>#</th><th>Customer</th><th>Service</th><th>Worker</th><th>Amount</th><th>Status</th></tr>
          </thead>
          <tbody>
          <% const sc={pending:'warning',accepted:'info',in_progress:'primary',completed:'success',cancelled:'danger'}; %>
          <% recentBookings.forEach(b => { %>
            <tr>
              <td><a href="/admin/bookings/<%= b.id %>" class="text-primary fw-medium">#<%= b.id %></a></td>
              <td><%= (b.User && b.User.name) ? b.User.name : '—' %></td>
              <td><%= (b.Service && b.Service.name) ? b.Service.name : '—' %></td>
              <td><%= (b.Worker && b.Worker.name) ? b.Worker.name : '<span class="text-muted">—</span>' %></td>
              <td class="fw-medium">₹<%= parseFloat(b.total_amount||0).toFixed(0) %></td>
              <td><span class="badge bg-<%= sc[b.status]||'secondary' %>" style="font-size:.6rem;"><%= b.status.replace('_',' ') %></span></td>
            </tr>
          <% }) %>
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <!-- Recent Workers -->
  <div class="col-lg-4">
    <div class="card border-0 shadow-sm">
      <div class="card-header bg-white border-bottom py-3 d-flex justify-content-between align-items-center">
        <h6 class="mb-0 fw-semibold"><i class="bi bi-person-badge me-2 text-warning"></i>Recent Workers</h6>
        <a href="/admin/workers" class="btn btn-sm btn-outline-primary">View All</a>
      </div>
      <div class="card-body p-0">
        <% recentWorkers.forEach(w => { %>
          <div class="d-flex align-items-center justify-content-between p-3 border-bottom">
            <div class="d-flex align-items-center gap-2">
              <div class="rounded-circle d-flex align-items-center justify-content-center" style="width:34px;height:34px;background:var(--primary-light);">
                <span class="fw-bold" style="color:var(--primary);font-size:.75rem;"><%= w.name[0].toUpperCase() %></span>
              </div>
              <div>
                <div class="fw-medium" style="font-size:.82rem;"><%= w.name %></div>
                <small class="text-muted" style="font-size:.7rem;"><%= w.phone %></small>
              </div>
            </div>
            <div class="d-flex gap-1">
              <% const avColor = {online:'success',offline:'secondary',busy:'warning'}; %>
              <span class="badge bg-<%= avColor[w.availability]||'secondary' %> rounded-pill" style="font-size:.55rem;"><%= w.availability||'offline' %></span>
              <% const stColor = {pending:'warning',approved:'success',rejected:'danger'}; %>
              <span class="badge bg-<%= stColor[w.status]||'secondary' %> rounded-pill" style="font-size:.55rem;"><%= w.status %></span>
            </div>
          </div>
        <% }) %>
      </div>
    </div>
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
<script>
// Revenue + Bookings Chart
new Chart(document.getElementById('revenueChart'), {
  type: 'bar',
  data: {
    labels: <%- JSON.stringify(monthLabels) %>,
    datasets: [
      {
        label: 'Revenue (₹)',
        data: <%- JSON.stringify(monthRevenue) %>,
        backgroundColor: 'rgba(108, 71, 255, 0.15)',
        borderColor: '#6c47ff',
        borderWidth: 2,
        borderRadius: 6,
        yAxisID: 'y',
      },
      {
        label: 'Bookings',
        data: <%- JSON.stringify(monthCounts) %>,
        type: 'line',
        borderColor: '#22c55e',
        backgroundColor: 'rgba(34, 197, 94, 0.1)',
        borderWidth: 2,
        tension: 0.4,
        fill: true,
        yAxisID: 'y1',
      }
    ],
  },
  options: {
    responsive: true,
    plugins: { legend: { position: 'top', labels: { font: { size: 11 } } } },
    scales: {
      y: { position: 'left', title: { display: true, text: 'Revenue (₹)', font: { size: 10 } }, ticks: { font: { size: 10 } } },
      y1: { position: 'right', grid: { drawOnChartArea: false }, title: { display: true, text: 'Bookings', font: { size: 10 } }, ticks: { font: { size: 10 } } },
    },
  },
});

// Status Doughnut
new Chart(document.getElementById('statusChart'), {
  type: 'doughnut',
  data: {
    labels: <%- JSON.stringify(statusLabels) %>,
    datasets: [{
      data: <%- JSON.stringify(statusCounts) %>,
      backgroundColor: ['#f59e0b', '#3b82f6', '#6c47ff', '#22c55e', '#ef4444'],
      borderWidth: 0,
    }],
  },
  options: {
    responsive: true,
    cutout: '65%',
    plugins: { legend: { position: 'bottom', labels: { font: { size: 11 }, padding: 12 } } },
  },
});
</script>

<%- include('partials/footer') %>
