<%- include('partials/header') %>

<!-- Flash -->
<% if(typeof success !== 'undefined' && success && success.length){ %><div class="alert alert-success alert-dismissible">✅ <%= success %></div><% } %>

<!-- Stat Cards -->
<div class="row g-3 mb-4">
  <div class="col-6 col-lg-3">
    <div class="stat-card" style="background:linear-gradient(135deg,#6c47ff,#a855f7)">
      <p>👥 Total Users</p><h3><%= totalUsers %></h3>
      <i class="bi bi-people-fill icon"></i>
    </div>
  </div>
  <div class="col-6 col-lg-3">
    <div class="stat-card" style="background:linear-gradient(135deg,#f59e0b,#ef4444)">
      <p>🏪 Total Vendors</p><h3><%= totalVendors %></h3>
      <i class="bi bi-shop icon"></i>
    </div>
  </div>
  <div class="col-6 col-lg-3">
    <div class="stat-card" style="background:linear-gradient(135deg,#10b981,#059669)">
      <p>📅 Total Bookings</p><h3><%= totalBookings %></h3>
      <i class="bi bi-calendar-check-fill icon"></i>
    </div>
  </div>
  <div class="col-6 col-lg-3">
    <div class="stat-card" style="background:linear-gradient(135deg,#3b82f6,#1d4ed8)">
      <p>💰 Total Revenue</p><h3>₹<%= parseFloat(totalRevenue).toFixed(0) %></h3>
      <i class="bi bi-currency-rupee icon"></i>
    </div>
  </div>
</div>

<!-- Revenue Breakdown -->
<div class="row g-3 mb-4">
  <div class="col-md-4">
    <div class="card h-100">
      <div class="card-body text-center py-4">
        <div style="font-size:2rem">💸</div>
        <h5 class="mt-2 mb-0 fw-bold text-success">₹<%= parseFloat(totalRevenue).toFixed(2) %></h5>
        <p class="text-muted small mt-1">Total Platform Revenue</p>
      </div>
    </div>
  </div>
  <div class="col-md-4">
    <div class="card h-100">
      <div class="card-body text-center py-4">
        <div style="font-size:2rem">🏷️</div>
        <h5 class="mt-2 mb-0 fw-bold text-primary">₹<%= parseFloat(platformRevenue).toFixed(2) %></h5>
        <p class="text-muted small mt-1">Platform Charges Collected</p>
      </div>
    </div>
  </div>
  <div class="col-md-4">
    <div class="card h-100">
      <div class="card-body text-center py-4">
        <div style="font-size:2rem">🧾</div>
        <h5 class="mt-2 mb-0 fw-bold text-warning">₹<%= parseFloat(gstCollected).toFixed(2) %></h5>
        <p class="text-muted small mt-1">GST Collected</p>
      </div>
    </div>
  </div>
</div>

<!-- Alerts Row -->
<div class="row g-3 mb-4">
  <div class="col-md-6">
    <div class="card border-warning">
      <div class="card-body d-flex align-items-center gap-3">
        <div style="font-size:2rem">⏳</div>
        <div>
          <h5 class="mb-0 fw-bold"><%= pendingKyc %></h5>
          <p class="mb-0 text-muted small">KYC Pending Review</p>
        </div>
        <a href="/admin/vendors?status=pending_kyc" class="btn btn-sm btn-warning ms-auto">Review →</a>
      </div>
    </div>
  </div>
  <div class="col-md-6">
    <div class="card border-info">
      <div class="card-body d-flex align-items-center gap-3">
        <div style="font-size:2rem">📋</div>
        <div>
          <h5 class="mb-0 fw-bold"><%= pendingBookings %></h5>
          <p class="mb-0 text-muted small">Pending Bookings</p>
        </div>
        <a href="/admin/bookings?status=pending" class="btn btn-sm btn-info ms-auto text-white">View →</a>
      </div>
    </div>
  </div>
</div>

<!-- Recent Tables -->
<div class="row g-3">
  <div class="col-lg-7">
    <div class="card">
      <div class="card-header d-flex justify-content-between align-items-center">
        <span>📅 Recent Bookings</span>
        <a href="/admin/bookings" class="btn btn-sm btn-outline-primary">View All</a>
      </div>
      <div class="table-responsive">
        <table class="table table-hover mb-0">
          <thead><tr><th>User</th><th>Service</th><th>Amount</th><th>Status</th></tr></thead>
          <tbody>
          <% recentBookings.forEach(b => { %>
            <tr>
              <td><%= b.User?.name || '—' %><br><small class="text-muted"><%= b.User?.mobile %></small></td>
              <td><%= b.Service?.name || '—' %></td>
              <td>₹<%= parseFloat(b.total_amount||b.amount||0).toFixed(0) %></td>
              <td>
                <% const sc={pending:'warning',accepted:'info',in_progress:'primary',completed:'success',cancelled:'danger'}; %>
                <span class="badge bg-<%= sc[b.status]||'secondary' %>"><%= b.status %></span>
              </td>
            </tr>
          <% }) %>
          <% if(!recentBookings.length){ %><tr><td colspan="4" class="text-center text-muted py-3">No bookings yet</td></tr><% } %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
  <div class="col-lg-5">
    <div class="card">
      <div class="card-header d-flex justify-content-between align-items-center">
        <span>🏪 Recent Vendors</span>
        <a href="/admin/vendors" class="btn btn-sm btn-outline-primary">View All</a>
      </div>
      <div class="table-responsive">
        <table class="table table-hover mb-0">
          <thead><tr><th>Vendor</th><th>KYC</th></tr></thead>
          <tbody>
          <% recentVendors.forEach(v => { %>
            <tr>
              <td>
                <a href="/admin/vendors/<%= v.id %>" class="text-decoration-none fw-semibold"><%= v.business_name||'—' %></a>
                <br><small class="text-muted"><%= v.User?.mobile %></small>
              </td>
              <td>
                <% const kc={pending:'secondary',under_review:'warning',approved:'success',rejected:'danger'}; %>
                <span class="badge bg-<%= kc[v.kyc_status] %>"><%= v.kyc_status %></span>
              </td>
            </tr>
          <% }) %>
          <% if(!recentVendors.length){ %><tr><td colspan="2" class="text-center text-muted py-3">No vendors yet</td></tr><% } %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>

<%- include('partials/footer') %>
