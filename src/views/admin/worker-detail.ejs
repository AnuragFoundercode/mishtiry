<%- include('partials/header') %>

<% if(success&&success.length){ %>
  <div class="alert alert-success alert-dismissible fade show"><i class="bi bi-check-circle-fill me-2"></i><%= success %><button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
<% } %>
<% if(error&&error.length){ %>
  <div class="alert alert-danger alert-dismissible fade show"><i class="bi bi-exclamation-triangle-fill me-2"></i><%= error %><button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
<% } %>

<% const statusColor = { pending: 'warning', approved: 'success', rejected: 'danger' }; %>
<% const workerServiceIds = (worker.Services || []).map(s => s.id); %>
<% const sc = {pending:'warning',accepted:'info',in_progress:'primary',completed:'success',cancelled:'danger'}; %>

<!-- Header -->
<div class="d-flex align-items-center justify-content-between mb-4">
  <div class="d-flex align-items-center gap-3">
    <a href="/admin/workers" class="btn btn-sm btn-light"><i class="bi bi-arrow-left"></i></a>
    <% if(worker.profile_image){ %>
      <img src="/uploads/<%= worker.profile_image %>" class="rounded-circle" style="width:48px;height:48px;object-fit:cover;border:2px solid var(--primary-light);"/>
    <% } else { %>
      <div class="rounded-circle d-flex align-items-center justify-content-center" style="width:48px;height:48px;background:var(--primary-light);">
        <span class="fw-bold" style="color:var(--primary);font-size:1.2rem;"><%= worker.name[0].toUpperCase() %></span>
      </div>
    <% } %>
    <div>
      <h5 class="fw-bold mb-0"><%= worker.name %> <small class="text-muted fw-normal">#<%= worker.id %></small></h5>
      <small class="text-muted"><%= worker.phone %><% if(worker.email){ %> · <%= worker.email %><% } %></small>
    </div>
  </div>
  <div class="d-flex gap-2 align-items-center">
    <span class="badge bg-<%= statusColor[worker.status]||'secondary' %> rounded-pill px-3"><%= worker.status || 'pending' %></span>
    <% if(worker.is_blocked){ %><span class="badge bg-danger rounded-pill">Blocked</span><% } %>
    
    <!-- Status Dropdown -->
    <div class="dropdown">
      <button class="btn btn-sm btn-outline-secondary dropdown-toggle" data-bs-toggle="dropdown">
        <i class="bi bi-shield-check me-1"></i>Change Status
      </button>
      <ul class="dropdown-menu dropdown-menu-end">
        <% ['pending', 'approved', 'rejected'].forEach(s => { %>
          <li>
            <form method="POST" action="/admin/workers/<%= worker.id %>/update-status">
              <input type="hidden" name="status" value="<%= s %>">
              <button type="submit" class="dropdown-item <%= worker.status === s ? 'active' : '' %>" <%= worker.status === s ? 'disabled' : '' %>>
                <% if(s==='pending'){ %><i class="bi bi-clock text-warning me-2"></i>
                <% } else if(s==='approved'){ %><i class="bi bi-check-circle text-success me-2"></i>
                <% } else { %><i class="bi bi-x-circle text-danger me-2"></i><% } %>
                <%= s.charAt(0).toUpperCase() + s.slice(1) %>
              </button>
            </form>
          </li>
        <% }) %>
      </ul>
    </div>

    <form method="POST" action="/admin/workers/<%= worker.id %>/toggle-block">
      <% if(worker.is_blocked){ %>
        <button class="btn btn-sm btn-outline-success" onclick="return confirm('Unblock?')"><i class="bi bi-unlock me-1"></i>Unblock</button>
      <% } else { %>
        <button class="btn btn-sm btn-outline-danger" onclick="return confirm('Block?')"><i class="bi bi-lock me-1"></i>Block</button>
      <% } %>
    </form>
  </div>
</div>

<!-- Stats Row -->
<div class="row g-3 mb-4">
  <div class="col-6 col-md-2">
    <div class="card border-0 shadow-sm text-center p-3">
      <div class="text-primary fw-bold fs-5"><%= assignedBookings.length %></div>
      <small class="text-muted" style="font-size:.7rem;">TOTAL JOBS</small>
    </div>
  </div>
  <div class="col-6 col-md-2">
    <div class="card border-0 shadow-sm text-center p-3">
      <div class="text-success fw-bold fs-5"><%= assignedBookings.filter(b=>b.status==='completed').length %></div>
      <small class="text-muted" style="font-size:.7rem;">COMPLETED</small>
    </div>
  </div>
  <div class="col-6 col-md-2">
    <div class="card border-0 shadow-sm text-center p-3">
      <div class="text-warning fw-bold fs-5">⭐ <%= worker.rating || '0' %></div>
      <small class="text-muted" style="font-size:.7rem;">RATING</small>
    </div>
  </div>
  <div class="col-6 col-md-2">
    <div class="card border-0 shadow-sm text-center p-3">
      <div class="text-info fw-bold fs-5">₹<%= parseFloat(workerProfit || 0).toFixed(0) %></div>
      <small class="text-muted" style="font-size:.7rem;">WORKER PROFIT</small>
    </div>
  </div>
  <div class="col-6 col-md-2">
    <div class="card border-0 shadow-sm text-center p-3">
      <div class="fw-bold fs-5" style="color:var(--primary);">₹<%= parseFloat(platformProfit || 0).toFixed(0) %></div>
      <small class="text-muted" style="font-size:.7rem;">PLATFORM PROFIT</small>
    </div>
  </div>
  <div class="col-6 col-md-2">
    <div class="card border-0 shadow-sm text-center p-3">
      <div class="text-danger fw-bold fs-5">₹<%= parseFloat(worker.admin_due || 0).toFixed(0) %></div>
      <small class="text-muted" style="font-size:.7rem;">ADMIN DUE</small>
    </div>
  </div>
</div>

<!-- Two Column Layout -->
<div class="row g-4">

  <!-- Left: Profile, Approval, Zone, Services, KYC -->
  <div class="col-lg-5">

    <!-- Zone + Info -->
    <div class="row g-3 mb-3">
      <div class="col-12">
        <div class="card border-0 shadow-sm">
          <div class="card-body p-3">
            <div class="d-flex align-items-center justify-content-between mb-2">
              <small class="text-muted fw-semibold"><i class="bi bi-geo-alt me-1"></i>Zone</small>
              <% if(worker.Zone){ %><span class="badge bg-light text-dark border"><%= worker.Zone.name %></span><% } %>
            </div>
            <form method="POST" action="/admin/workers/<%= worker.id %>/update-zone">
              <div class="input-group input-group-sm">
                <span class="input-group-text"><i class="bi bi-geo-alt"></i></span>
                <select name="zone_id" class="form-select form-select-sm">
                  <option value="">No Zone</option>
                  <% allZones.forEach(z => { %>
                    <option value="<%= z.id %>" <%= worker.zone_id == z.id ? 'selected' : '' %>><%= z.name %></option>
                  <% }) %>
                </select>
                <button class="btn btn-primary btn-sm" type="submit">Set</button>
              </div>
            </form>
          </div>
        </div>
      </div>
    </div>

    <!-- Services -->
    <div class="card border-0 shadow-sm mb-3">
      <div class="card-body p-3">
        <div class="d-flex justify-content-between align-items-center mb-2">
          <small class="text-muted fw-semibold"><i class="bi bi-tools me-1"></i>Services</small>
          <span class="badge bg-primary rounded-pill" style="font-size:.6rem;"><%= workerServiceIds.length %></span>
        </div>
        <form method="POST" action="/admin/workers/<%= worker.id %>/update-services">
          <div style="max-height:180px;overflow-y:auto;margin-bottom:8px;">
            <% allServices.forEach(s => { %>
              <label class="d-flex align-items-center gap-2 py-1 px-2 rounded mb-1" style="cursor:pointer;font-size:.78rem;<%= workerServiceIds.includes(s.id)?'background:var(--primary-light);':'' %>">
                <input class="form-check-input m-0" type="checkbox" name="service_ids" value="<%= s.id %>" <%= workerServiceIds.includes(s.id)?'checked':'' %>>
                <span class="<%= workerServiceIds.includes(s.id)?'fw-semibold':'' %>"><%= s.name %></span>
              </label>
            <% }) %>
          </div>
          <button class="btn btn-primary btn-sm w-100">Update Services</button>
        </form>
      </div>
    </div>

    <!-- KYC / Aadhaar -->
    <div class="card border-0 shadow-sm mb-3">
      <div class="card-body p-3">
        <small class="text-muted fw-semibold d-block mb-2"><i class="bi bi-credit-card-2-front me-1"></i>KYC / Aadhaar</small>
        <div class="small mb-2">No: <span class="fw-semibold font-monospace"><%= worker.aadhaar_number || '—' %></span></div>
        <div class="row g-2">
          <div class="col-6">
            <% if(worker.aadhaar_front){ %>
              <a href="/uploads/<%= worker.aadhaar_front %>" target="_blank"><img src="/uploads/<%= worker.aadhaar_front %>" class="rounded border w-100" style="height:60px;object-fit:cover;"/></a>
            <% } else { %>
              <div class="border rounded text-center py-2 bg-light"><small class="text-muted">No Front</small></div>
            <% } %>
          </div>
          <div class="col-6">
            <% if(worker.aadhaar_back){ %>
              <a href="/uploads/<%= worker.aadhaar_back %>" target="_blank"><img src="/uploads/<%= worker.aadhaar_back %>" class="rounded border w-100" style="height:60px;object-fit:cover;"/></a>
            <% } else { %>
              <div class="border rounded text-center py-2 bg-light"><small class="text-muted">No Back</small></div>
            <% } %>
          </div>
        </div>
      </div>
    </div>

    <!-- Edit Profile -->
    <div class="card border-0 shadow-sm">
      <div class="card-body p-3">
        <small class="text-muted fw-semibold d-block mb-2"><i class="bi bi-pencil me-1"></i>Edit Profile</small>
        <form method="POST" action="/admin/workers/<%= worker.id %>/update-profile" enctype="multipart/form-data">
          <div class="row g-2 mb-2">
            <div class="col-6"><input type="text" name="name" class="form-control form-control-sm" value="<%= worker.name %>" placeholder="Name"/></div>
            <div class="col-6"><input type="text" name="phone" class="form-control form-control-sm" value="<%= worker.phone %>" placeholder="Phone"/></div>
          </div>
          <input type="email" name="email" class="form-control form-control-sm mb-2" value="<%= worker.email || '' %>" placeholder="Email"/>
          <input type="file" name="profile_image" class="form-control form-control-sm mb-2" accept="image/*"/>
          <button class="btn btn-primary btn-sm w-100">Save</button>
        </form>
      </div>
    </div>

  </div>

  <!-- Right: Bookings + Financials -->
  <div class="col-lg-7">

    <!-- Financial Summary -->
    <div class="card border-0 shadow-sm mb-3">
      <div class="card-body p-3">
        <small class="text-muted fw-semibold d-block mb-2"><i class="bi bi-cash-stack me-1"></i>Financial Summary</small>
        <div class="row g-2 text-center">
          <div class="col-4">
            <div class="p-2 rounded" style="background:#ecfdf5;">
              <div class="fw-bold text-success">₹<%= parseFloat(totalRevenue || 0).toFixed(0) %></div>
              <small class="text-muted" style="font-size:.65rem;">Total Revenue</small>
            </div>
          </div>
          <div class="col-4">
            <div class="p-2 rounded" style="background:#ede9ff;">
              <div class="fw-bold" style="color:var(--primary);">₹<%= parseFloat(platformProfit || 0).toFixed(0) %></div>
              <small class="text-muted" style="font-size:.65rem;">Platform Earned</small>
            </div>
          </div>
          <div class="col-4">
            <div class="p-2 rounded" style="background:#dbeafe;">
              <div class="fw-bold text-info">₹<%= parseFloat(workerProfit || 0).toFixed(0) %></div>
              <small class="text-muted" style="font-size:.65rem;">Worker Earned</small>
            </div>
          </div>
        </div>
        <div class="row g-2 mt-2 text-center">
          <div class="col-4">
            <div class="p-2 rounded" style="background:#fef9c3;">
              <div class="fw-bold text-warning">₹<%= parseFloat(totalCollected || 0).toFixed(0) %></div>
              <small class="text-muted" style="font-size:.65rem;">COD Collected</small>
            </div>
          </div>
          <div class="col-4">
            <div class="p-2 rounded" style="background:#fee2e2;">
              <div class="fw-bold text-danger">₹<%= parseFloat(totalAdminDue || 0).toFixed(0) %></div>
              <small class="text-muted" style="font-size:.65rem;">Admin Due (COD)</small>
            </div>
          </div>
          <div class="col-4">
            <div class="p-2 rounded" style="background:#e0e7ff;">
              <div class="fw-bold" style="color:#6366f1;">₹<%= parseFloat(worker.wallet || 0).toFixed(0) %></div>
              <small class="text-muted" style="font-size:.65rem;">Wallet Balance</small>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Payout Requests -->
    <div class="card border-0 shadow-sm mb-3">
      <div class="card-header d-flex justify-content-between align-items-center">
        <small class="fw-semibold"><i class="bi bi-wallet2 me-2 text-primary"></i>Payout Requests</small>
        <% if(parseFloat(worker.admin_due||0) > 0){ %>
          <button class="btn btn-sm btn-outline-danger" data-bs-toggle="modal" data-bs-target="#clearDueModal" style="font-size:.72rem;">
            <i class="bi bi-cash-coin me-1"></i>Clear Due ₹<%= parseFloat(worker.admin_due||0).toFixed(0) %>
          </button>
        <% } %>
      </div>
      <div class="card-body p-3">
        <% if(typeof payoutRequests !== 'undefined' && payoutRequests.length){ %>
          <div class="table-responsive">
            <table class="table table-sm mb-0" style="font-size:.75rem;">
              <thead class="table-light"><tr><th>#</th><th>Amount</th><th>Status</th><th>Note</th><th>Date</th></tr></thead>
              <tbody>
              <% const psc={pending:'warning',approved:'info',paid:'success',rejected:'danger'}; %>
              <% payoutRequests.forEach(p => { %>
                <tr>
                  <td class="text-muted">#<%= p.id %></td>
                  <td class="fw-semibold text-success">₹<%= parseFloat(p.amount).toFixed(2) %></td>
                  <td><span class="badge bg-<%= psc[p.status]||'secondary' %>" style="font-size:.6rem;"><%= p.status %></span></td>
                  <td class="text-muted"><%= p.admin_note || p.note || '—' %></td>
                  <td class="text-muted"><%= new Date(p.created_at).toLocaleDateString('en-IN',{day:'2-digit',month:'short'}) %></td>
                </tr>
              <% }) %>
              </tbody>
            </table>
          </div>
        <% } else { %>
          <p class="text-muted small mb-0 text-center py-2">No payout requests yet</p>
        <% } %>
        <a href="/admin/payout-requests" class="btn btn-sm btn-light w-100 mt-2" style="font-size:.75rem;">View All Payout Requests</a>
      </div>
    </div>

    <!-- Bookings Table -->
    <div class="card border-0 shadow-sm">
      <div class="card-header bg-white border-bottom py-2 d-flex justify-content-between align-items-center">
        <small class="fw-semibold"><i class="bi bi-calendar-check me-2 text-primary"></i>Bookings</small>
        <span class="badge bg-primary rounded-pill" style="font-size:.6rem;"><%= assignedBookings.length %></span>
      </div>
      <div class="table-responsive" style="max-height:450px;overflow-y:auto;">
        <table class="table table-hover mb-0" style="font-size:.78rem;">
          <thead class="table-light sticky-top">
            <tr><th>#</th><th>Customer</th><th>Service</th><th>Amount</th><th>Payment</th><th>Status</th></tr>
          </thead>
          <tbody>
          <% assignedBookings.forEach(b => { %>
            <tr>
              <td><a href="/admin/bookings/<%= b.id %>" class="text-primary fw-medium">#<%= b.id %></a></td>
              <td><%= (b.User && b.User.name) ? b.User.name : '—' %></td>
              <td><%= (b.Service && b.Service.name) ? b.Service.name : '—' %></td>
              <td class="fw-medium">₹<%= parseFloat(b.total_amount||0).toFixed(0) %></td>
              <td>
                <% if(b.payment_method === 'cod'){ %>
                  <span class="badge bg-warning text-dark" style="font-size:.55rem;">COD</span>
                <% } else { %>
                  <span class="badge bg-info" style="font-size:.55rem;">Online</span>
                <% } %>
              </td>
              <td><span class="badge bg-<%= sc[b.status]||'secondary' %>" style="font-size:.55rem;"><%= b.status.replace('_',' ') %></span></td>
            </tr>
          <% }) %>
          <% if(!assignedBookings.length){ %>
            <tr><td colspan="6" class="text-center py-4 text-muted small">No bookings yet</td></tr>
          <% } %>
          </tbody>
        </table>
      </div>
    </div>

  </div>
</div>

<%- include('partials/footer') %>

<!-- Clear Due Modal -->
<div class="modal fade" id="clearDueModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title"><i class="bi bi-cash-coin me-2 text-danger"></i>Clear Admin Due</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <form method="POST" action="/admin/workers/<%= worker.id %>/clear-due">
        <div class="modal-body">
          <p class="mb-3">Current due: <strong class="text-danger">₹<%= parseFloat(worker.admin_due||0).toFixed(2) %></strong></p>
          <div class="mb-1">
            <label class="form-label">Amount to Clear</label>
            <div class="input-group">
              <span class="input-group-text">₹</span>
              <input type="number" name="amount" class="form-control" step="0.01" min="1" max="<%= parseFloat(worker.admin_due||0) %>" placeholder="Leave blank to clear full due">
            </div>
            <small class="text-muted">Leave blank to clear full amount</small>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-danger" onclick="return confirm('Clear this due?')">Clear Due</button>
        </div>
      </form>
    </div>
  </div>
</div>
