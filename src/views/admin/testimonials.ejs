<%- include('partials/header') %>

<% if(success&&success.length){ %>
  <div class="alert alert-success alert-dismissible fade show" role="alert">
    <i class="bi bi-check-circle-fill me-2"></i><%= success %>
    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
  </div>
<% } %>
<% if(error&&error.length){ %>
  <div class="alert alert-danger alert-dismissible fade show" role="alert">
    <i class="bi bi-exclamation-triangle-fill me-2"></i><%= error %>
    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
  </div>
<% } %>

<div class="row g-4">
  <!-- Add Testimonial -->
  <div class="col-lg-4">
    <div class="card border-0 shadow-sm">
      <div class="card-header bg-white border-bottom">
        <h6 class="mb-0 fw-semibold text-dark">
          <i class="bi bi-plus-circle me-2 text-primary"></i>Add Testimonial
        </h6>
      </div>
      <div class="card-body p-4">
        <form method="POST" action="/admin/testimonials" enctype="multipart/form-data">
          <div class="mb-3">
            <label class="form-label fw-medium">Name <span class="text-danger">*</span></label>
            <input type="text" name="name" class="form-control" placeholder="Customer name" required/>
          </div>
          <div class="mb-3">
            <label class="form-label fw-medium">Designation <small class="text-muted">(optional)</small></label>
            <input type="text" name="designation" class="form-control" placeholder="e.g. Business Owner, Homemaker"/>
          </div>
          <div class="mb-3">
            <label class="form-label fw-medium">Photo <small class="text-muted">(optional)</small></label>
            <input type="file" name="image" class="form-control" accept="image/*"/>
          </div>
          <div class="mb-3">
            <label class="form-label fw-medium">Rating</label>
            <select name="rating" class="form-select">
              <option value="5">⭐⭐⭐⭐⭐ (5)</option>
              <option value="4.5">⭐⭐⭐⭐½ (4.5)</option>
              <option value="4">⭐⭐⭐⭐ (4)</option>
              <option value="3.5">⭐⭐⭐½ (3.5)</option>
              <option value="3">⭐⭐⭐ (3)</option>
            </select>
          </div>
          <div class="mb-3">
            <label class="form-label fw-medium">Message <span class="text-danger">*</span></label>
            <textarea name="message" class="form-control" rows="3" placeholder="What the customer said..." required></textarea>
          </div>
          <div class="mb-3">
            <label class="form-label fw-medium">Sort Order</label>
            <input type="number" name="sort_order" class="form-control" value="0" min="0" placeholder="0 = first"/>
          </div>
          <button class="btn btn-primary w-100">
            <i class="bi bi-plus-lg me-1"></i>Add Testimonial
          </button>
        </form>
      </div>
    </div>
  </div>

  <!-- Testimonials List -->
  <div class="col-lg-8">
    <div class="card border-0 shadow-sm">
      <div class="card-header bg-white border-bottom">
        <div class="d-flex justify-content-between align-items-center">
          <h6 class="mb-0 fw-semibold text-dark">
            <i class="bi bi-chat-quote me-2 text-primary"></i>All Testimonials
          </h6>
          <span class="badge bg-primary"><%= testimonials.length %> total</span>
        </div>
      </div>
      <div class="card-body p-0">
        <% if(testimonials.length){ %>
          <% testimonials.forEach((t, i) => { %>
            <div class="d-flex align-items-start gap-3 p-3 border-bottom">
              <!-- Avatar -->
              <% if(t.image){ %>
                <img src="/uploads/<%= t.image %>" class="rounded-circle" style="width:50px;height:50px;object-fit:cover;" alt="<%= t.name %>"/>
              <% } else { %>
                <div class="bg-primary bg-opacity-10 rounded-circle d-flex align-items-center justify-content-center flex-shrink-0" style="width:50px;height:50px;">
                  <span class="fw-bold text-primary"><%= t.name[0].toUpperCase() %></span>
                </div>
              <% } %>

              <!-- Content -->
              <div class="flex-grow-1">
                <div class="d-flex justify-content-between align-items-start">
                  <div>
                    <h6 class="fw-semibold mb-0"><%= t.name %></h6>
                    <% if(t.designation){ %>
                      <small class="text-muted"><%= t.designation %></small>
                    <% } %>
                  </div>
                  <div class="d-flex align-items-center gap-1">
                    <span class="badge <%= t.is_active ? 'bg-success' : 'bg-secondary' %> rounded-pill" style="font-size:.65rem;">
                      <%= t.is_active ? 'Active' : 'Inactive' %>
                    </span>
                    <span class="badge bg-warning text-dark" style="font-size:.7rem;">
                      ⭐ <%= t.rating %>
                    </span>
                  </div>
                </div>
                <p class="text-muted small mt-1 mb-2">"<%= t.message %>"</p>
                <div class="btn-group btn-group-sm">
                  <button class="btn btn-outline-primary" data-bs-toggle="modal" data-bs-target="#editTestimonial<%= t.id %>" title="Edit">
                    <i class="bi bi-pencil"></i>
                  </button>
                  <form method="POST" action="/admin/testimonials/<%= t.id %>/delete" class="d-inline">
                    <button class="btn btn-outline-danger" onclick="return confirm('Delete this testimonial?')" title="Delete">
                      <i class="bi bi-trash"></i>
                    </button>
                  </form>
                </div>
              </div>
            </div>

            <!-- Edit Modal -->
            <div class="modal fade" id="editTestimonial<%= t.id %>" tabindex="-1">
              <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content border-0 shadow">
                  <div class="modal-header bg-light border-bottom">
                    <h6 class="modal-title fw-semibold">
                      <i class="bi bi-pencil text-primary me-2"></i>Edit Testimonial
                    </h6>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                  </div>
                  <form method="POST" action="/admin/testimonials/<%= t.id %>/update" enctype="multipart/form-data">
                    <div class="modal-body p-4">
                      <div class="mb-3">
                        <label class="form-label fw-medium">Name</label>
                        <input type="text" name="name" class="form-control" value="<%= t.name %>" required/>
                      </div>
                      <div class="mb-3">
                        <label class="form-label fw-medium">Designation</label>
                        <input type="text" name="designation" class="form-control" value="<%= t.designation || '' %>"/>
                      </div>
                      <div class="mb-3">
                        <label class="form-label fw-medium">Photo <small class="text-muted">(leave empty to keep current)</small></label>
                        <input type="file" name="image" class="form-control" accept="image/*"/>
                        <% if(t.image){ %>
                          <img src="/uploads/<%= t.image %>" class="rounded mt-2" style="width:40px;height:40px;object-fit:cover;"/>
                        <% } %>
                      </div>
                      <div class="mb-3">
                        <label class="form-label fw-medium">Rating</label>
                        <select name="rating" class="form-select">
                          <option value="5" <%= t.rating==5?'selected':'' %>>⭐⭐⭐⭐⭐ (5)</option>
                          <option value="4.5" <%= t.rating==4.5?'selected':'' %>>⭐⭐⭐⭐½ (4.5)</option>
                          <option value="4" <%= t.rating==4?'selected':'' %>>⭐⭐⭐⭐ (4)</option>
                          <option value="3.5" <%= t.rating==3.5?'selected':'' %>>⭐⭐⭐½ (3.5)</option>
                          <option value="3" <%= t.rating==3?'selected':'' %>>⭐⭐⭐ (3)</option>
                        </select>
                      </div>
                      <div class="mb-3">
                        <label class="form-label fw-medium">Message</label>
                        <textarea name="message" class="form-control" rows="3" required><%= t.message %></textarea>
                      </div>
                      <div class="row g-2">
                        <div class="col-6">
                          <label class="form-label fw-medium">Sort Order</label>
                          <input type="number" name="sort_order" class="form-control" value="<%= t.sort_order %>"/>
                        </div>
                        <div class="col-6">
                          <label class="form-label fw-medium">Status</label>
                          <select name="is_active" class="form-select">
                            <option value="1" <%= t.is_active?'selected':'' %>>Active</option>
                            <option value="0" <%= !t.is_active?'selected':'' %>>Inactive</option>
                          </select>
                        </div>
                      </div>
                    </div>
                    <div class="modal-footer bg-light border-top">
                      <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                      <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg me-1"></i>Save</button>
                    </div>
                  </form>
                </div>
              </div>
            </div>
          <% }) %>
        <% } else { %>
          <div class="text-center py-5 text-muted">
            <i class="bi bi-chat-quote" style="font-size:2rem;"></i>
            <p class="mt-2 mb-0">No testimonials yet</p>
          </div>
        <% } %>
      </div>
    </div>
  </div>
</div>

<%- include('partials/footer') %>
