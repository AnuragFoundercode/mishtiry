<%- include('partials/header') %>

<% if(success&&success.length){ %><div class="alert alert-success alert-dismissible fade show" role="alert">
  <i class="bi bi-check-circle-fill me-2"></i><%= success %>
  <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
</div><% } %>
<% if(error&&error.length){ %><div class="alert alert-danger alert-dismissible fade show" role="alert">
  <i class="bi bi-exclamation-triangle-fill me-2"></i><%= error %>
  <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
</div><% } %>

<div class="d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center gap-3 mb-4">
  <div>
    <h4 class="mb-1 fw-bold text-dark">
      <i class="bi bi-clock-fill text-primary me-2"></i>Time Slots
    </h4>
    <p class="text-muted mb-0 small">Manage booking time slots with date and capacity</p>
  </div>
  <button class="btn btn-primary d-flex align-items-center gap-2" data-bs-toggle="modal" data-bs-target="#slotModal" onclick="resetForm()">
    <i class="bi bi-plus-lg"></i>
    <span>Create Slot</span>
  </button>
</div>

<!-- Date Filter -->
<div class="card border-0 shadow-sm mb-4">
  <div class="card-body py-3">
    <form method="GET" action="/admin/slots" class="row g-2 align-items-end">
      <div class="col-auto">
        <label class="form-label small fw-semibold mb-1">Filter by Date</label>
        <input type="date" name="date" class="form-control" value="<%= filterDate || '' %>" />
      </div>
      <div class="col-auto">
        <button type="submit" class="btn btn-primary btn-sm"><i class="bi bi-funnel me-1"></i>Filter</button>
      </div>
      <% if(filterDate){ %>
      <div class="col-auto">
        <a href="/admin/slots" class="btn btn-outline-secondary btn-sm"><i class="bi bi-x-lg me-1"></i>Clear</a>
      </div>
      <% } %>
    </form>
  </div>
</div>

<!-- Slots Table -->
<div class="card border-0 shadow-sm">
  <div class="card-body p-0">
    <% if(slots.length){ %>
    <div class="table-responsive">
      <table class="table table-hover mb-0">
        <thead>
          <tr>
            <th>#</th>
            <th>Date</th>
            <th>Start Time</th>
            <th>End Time</th>
            <th>Max Bookings</th>
            <th>Current Bookings</th>
            <th>Status</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          <% slots.forEach((slot, i) => { %>
          <tr>
            <td><%= i + 1 %></td>
            <td><span class="fw-semibold"><%= new Date(slot.date).toLocaleDateString('en-IN', { day: '2-digit', month: 'short', year: 'numeric' }) %></span></td>
            <td><i class="bi bi-clock text-primary me-1"></i><%= slot.start_time %></td>
            <td><i class="bi bi-clock-history text-muted me-1"></i><%= slot.end_time %></td>
            <td><span class="badge bg-info"><%= slot.max_bookings %></span></td>
            <td><span class="badge bg-warning text-dark"><%= slot.current_bookings || 0 %></span></td>
            <td>
              <span class="badge <%= slot.is_active ? 'bg-success' : 'bg-secondary' %>">
                <%= slot.is_active ? 'Active' : 'Inactive' %>
              </span>
            </td>
            <td>
              <div class="d-flex gap-1">
                <button class="btn btn-sm btn-outline-primary edit-slot-btn"
                  data-id="<%= slot.id %>"
                  data-date="<%= slot.date %>"
                  data-start="<%= slot.start_time %>"
                  data-end="<%= slot.end_time %>"
                  data-max="<%= slot.max_bookings %>"
                  data-active="<%= slot.is_active ? '1' : '0' %>"
                  title="Edit">
                  <i class="bi bi-pencil"></i>
                </button>
                <form method="POST" action="/admin/slots/<%= slot.id %>/delete" onsubmit="return confirm('Delete this slot?')" class="d-inline">
                  <button type="submit" class="btn btn-sm btn-outline-danger" title="Delete">
                    <i class="bi bi-trash"></i>
                  </button>
                </form>
              </div>
            </td>
          </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
    <% } else { %>
    <div class="text-center py-5">
      <i class="bi bi-clock text-muted" style="font-size:3rem;"></i>
      <h6 class="text-muted mt-3 mb-2">No slots found</h6>
      <p class="text-muted small">Create time slots for users to book appointments</p>
    </div>
    <% } %>
  </div>
</div>

<!-- Create/Edit Slot Modal -->
<div class="modal fade" id="slotModal" tabindex="-1">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content border-0 shadow">
      <div class="modal-header bg-light border-bottom">
        <h5 class="modal-title fw-semibold" id="slotModalTitle">
          <i class="bi bi-clock-fill text-primary me-2"></i>Create Slot
        </h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <form id="slotForm" method="POST" action="/admin/slots">
        <div class="modal-body p-4">
          <div class="mb-3">
            <label class="form-label fw-semibold">Date <span class="text-danger">*</span></label>
            <input type="date" name="date" id="slot_date" class="form-control" required />
          </div>
          <div class="row g-3">
            <div class="col-6">
              <label class="form-label fw-semibold">Start Time <span class="text-danger">*</span></label>
              <input type="time" name="start_time" id="slot_start" class="form-control" required />
            </div>
            <div class="col-6">
              <label class="form-label fw-semibold">End Time <span class="text-danger">*</span></label>
              <input type="time" name="end_time" id="slot_end" class="form-control" required />
            </div>
          </div>
          <div class="mb-3 mt-3">
            <label class="form-label fw-semibold">Max Bookings</label>
            <input type="number" name="max_bookings" id="slot_max" class="form-control" value="10" min="1" />
          </div>
          <div class="mb-0">
            <label class="form-label fw-semibold">Status</label>
            <select name="is_active" id="slot_active" class="form-select">
              <option value="1" selected>Active</option>
              <option value="0">Inactive</option>
            </select>
          </div>
        </div>
        <div class="modal-footer bg-light border-top">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg me-1"></i>Save Slot</button>
        </div>
      </form>
    </div>
  </div>
</div>

<script>
function resetForm() {
  document.getElementById('slotModalTitle').innerHTML = '<i class="bi bi-clock-fill text-primary me-2"></i>Create Slot';
  document.getElementById('slotForm').action = '/admin/slots';
  document.getElementById('slot_date').value = '';
  document.getElementById('slot_start').value = '';
  document.getElementById('slot_end').value = '';
  document.getElementById('slot_max').value = '10';
  document.getElementById('slot_active').value = '1';
}

document.querySelectorAll('.edit-slot-btn').forEach(function(btn) {
  btn.addEventListener('click', function() {
    var id = this.dataset.id;
    var date = this.dataset.date;
    var start = this.dataset.start;
    var end = this.dataset.end;
    var max = this.dataset.max;
    var active = this.dataset.active;

    document.getElementById('slotModalTitle').innerHTML = '<i class="bi bi-clock-fill text-primary me-2"></i>Edit Slot';
    document.getElementById('slotForm').action = '/admin/slots/' + id + '/update';
    document.getElementById('slot_date').value = date;
    document.getElementById('slot_start').value = start;
    document.getElementById('slot_end').value = end;
    document.getElementById('slot_max').value = max;
    document.getElementById('slot_active').value = active;

    new bootstrap.Modal(document.getElementById('slotModal')).show();
  });
});
</script>

<%- include('partials/footer') %>
