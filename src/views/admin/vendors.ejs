<%- include('partials/header') %>

<% if(success&&success.length){ %><div class="alert alert-success">✅ <%= success %></div><% } %>
<% if(error&&error.length){ %><div class="alert alert-danger">⚠️ <%= error %></div><% } %>

<div class="card">
  <div class="card-header d-flex flex-wrap gap-2 justify-content-between align-items-center">
    <span>🏪 Vendors <span class="badge bg-primary ms-1"><%= total %></span></span>
    <div class="d-flex gap-2 flex-wrap align-items-center">
      <a href="/admin/vendors" class="btn btn-sm <%= !status?'btn-primary':'btn-outline-secondary' %>">All</a>
      <a href="/admin/vendors?status=pending_kyc" class="btn btn-sm <%= status==='pending_kyc'?'btn-warning':'btn-outline-warning' %>">⏳ KYC Pending</a>
      <a href="/admin/vendors?status=approved" class="btn btn-sm <%= status==='approved'?'btn-success':'btn-outline-success' %>">✅ Approved</a>
      <a href="/admin/vendors?status=suspended" class="btn btn-sm <%= status==='suspended'?'btn-danger':'btn-outline-danger' %>">🚫 Suspended</a>
      <a href="/admin/vendors?status=featured" class="btn btn-sm <%= status==='featured'?'btn-warning text-dark':'btn-outline-warning' %>">⭐ Featured</a>
      <button class="btn btn-sm btn-primary ms-2" data-bs-toggle="modal" data-bs-target="#createVendorModal">
        <i class="bi bi-plus-lg"></i> Create Vendor
      </button>
    </div>
  </div>

  <div class="table-responsive">
    <table class="table table-hover mb-0">
      <thead>
        <tr><th>#</th><th>Business</th><th>Owner</th><th>Mobile</th><th>KYC</th><th>Status</th><th>Revenue Model</th><th>Action</th></tr>
      </thead>
      <tbody>
      <% vendors.forEach((v,i) => { %>
        <tr>
          <td class="text-muted small"><%= (currentPage-1)*15+i+1 %></td>
          <td>
            <div class="d-flex align-items-center gap-2">
              <% if(v.logo){ %>
                <img src="/uploads/<%= v.logo %>" style="width:32px;height:32px;border-radius:8px;object-fit:cover"/>
              <% } else { %>
                <div style="width:32px;height:32px;border-radius:8px;background:#ede9ff;display:flex;align-items:center;justify-content:center;font-size:.9rem">🏪</div>
              <% } %>
              <a href="/admin/vendors/<%= v.id %>" class="fw-semibold text-decoration-none"><%= v.business_name||'—' %></a>
              <% if(v.is_featured){ %><span class="badge bg-warning text-dark" style="font-size:.6rem">⭐</span><% } %>
            </div>
          </td>
          <td><%= v.User?.name||'—' %></td>
          <td>📱 <%= v.User?.mobile||'—' %></td>
          <td>
            <% const kc={pending:'secondary',under_review:'warning',approved:'success',rejected:'danger'};
               const ke={pending:'⏸️',under_review:'⏳',approved:'✅',rejected:'❌'}; %>
            <span class="badge bg-<%= kc[v.kyc_status] %>"><%= ke[v.kyc_status] %> <%= v.kyc_status %></span>
          </td>
          <td>
            <% if(v.is_suspended){ %><span class="badge bg-danger">🚫 Suspended</span>
            <% } else if(v.is_approved){ %><span class="badge bg-success">✅ Active</span>
            <% } else { %><span class="badge bg-secondary">⏸️ Pending</span><% } %>
          </td>
          <td>
            <% if(v.revenue_model){ %>
              <span class="badge bg-info text-dark"><%= v.revenue_model %><%= v.commission_percent ? ` (${v.commission_percent}%)` : '' %></span>
            <% } else { %><span class="text-muted small">Default</span><% } %>
          </td>
          <td>
            <a href="/admin/vendors/<%= v.id %>" class="btn btn-sm btn-outline-primary">View →</a>
          </td>
        </tr>
      <% }) %>
      <% if(!vendors.length){ %>
        <tr><td colspan="8" class="text-center text-muted py-4">No vendors found</td></tr>
      <% } %>
      </tbody>
    </table>
  </div>

  <% if(pages>1){ %>
  <div class="card-footer d-flex justify-content-between align-items-center">
    <small class="text-muted">Showing <%= (currentPage-1)*15+1 %>–<%= Math.min(currentPage*15,total) %> of <%= total %></small>
    <nav><ul class="pagination pagination-sm mb-0">
      <% for(let p=1;p<=pages;p++){ %>
        <li class="page-item <%= p==currentPage?'active':'' %>"><a class="page-link" href="?page=<%= p %>&status=<%= status %>"><%= p %></a></li>
      <% } %>
    </ul></nav>
  </div>
  <% } %>
</div>

<!-- ── Create Vendor Modal ─────────────────────────────────────────────────── -->
<div class="modal fade" id="createVendorModal" tabindex="-1">
  <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
    <div class="modal-content">
      <div class="modal-header">
        <h6 class="modal-title">🏪 Create New Vendor</h6>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <form method="POST" action="/admin/vendors/create" enctype="multipart/form-data">
        <div class="modal-body">

          <p class="text-muted small mb-3">Admin creates vendor account directly. Vendor can later login with their mobile number via OTP.</p>

          <!-- Owner Info -->
          <div class="fw-semibold small text-uppercase text-muted mb-2 mt-1">👤 Owner Details</div>
          <div class="row g-3 mb-3">
            <div class="col-md-4">
              <label class="form-label">Owner Name</label>
              <input type="text" name="name" class="form-control" placeholder="Ramesh Kumar"/>
            </div>
            <div class="col-md-4">
              <label class="form-label">Mobile <span class="text-danger">*</span></label>
              <input type="text" name="mobile" class="form-control" placeholder="9876543210" required maxlength="15"/>
            </div>
            <div class="col-md-4">
              <label class="form-label">Email</label>
              <input type="email" name="email" class="form-control" placeholder="vendor@email.com"/>
            </div>
          </div>

          <!-- Business Info -->
          <div class="fw-semibold small text-uppercase text-muted mb-2">🏪 Business Details</div>
          <div class="row g-3 mb-3">
            <div class="col-md-6">
              <label class="form-label">Business Name <span class="text-danger">*</span></label>
              <input type="text" name="business_name" class="form-control" placeholder="Kumar Plumbing Services" required/>
            </div>
            <div class="col-md-6">
              <label class="form-label">Address</label>
              <input type="text" name="address" class="form-control" placeholder="Lajpat Nagar, New Delhi"/>
            </div>
            <div class="col-12">
              <label class="form-label">Description</label>
              <textarea name="description" class="form-control" rows="2" placeholder="About the business..."></textarea>
            </div>
            <div class="col-md-6">
              <label class="form-label">Latitude</label>
              <input type="number" name="latitude" class="form-control" step="any" placeholder="28.6139"/>
            </div>
            <div class="col-md-6">
              <label class="form-label">Longitude</label>
              <input type="number" name="longitude" class="form-control" step="any" placeholder="77.2090"/>
            </div>
          </div>

          <!-- Images -->
          <div class="fw-semibold small text-uppercase text-muted mb-2">🖼️ Images</div>
          <div class="row g-3">
            <div class="col-md-6">
              <label class="form-label">Logo <small class="text-muted">(optional)</small></label>
              <input type="file" name="logo" class="form-control" accept="image/*"/>
            </div>
            <div class="col-md-6">
              <label class="form-label">Banner <small class="text-muted">(optional)</small></label>
              <input type="file" name="banner" class="form-control" accept="image/*"/>
            </div>
          </div>

        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-light btn-sm" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-primary btn-sm">🏪 Create Vendor</button>
        </div>
      </form>
    </div>
  </div>
</div>

<%- include('partials/footer') %>
