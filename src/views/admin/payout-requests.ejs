<%- include('partials/header') %>

<% if(success&&success.length){ %>
  <div class="alert alert-success alert-dismissible fade show"><i class="bi bi-check-circle-fill me-2"></i><%= success %><button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
<% } %>
<% if(error&&error.length){ %>
  <div class="alert alert-danger alert-dismissible fade show"><i class="bi bi-exclamation-triangle-fill me-2"></i><%= error %><button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
<% } %>

<% const sc = { pending:'warning', approved:'info', paid:'success', rejected:'danger' }; %>

<!-- Page Header -->
<div class="d-flex align-items-center justify-content-between mb-4">
  <div>
    <h5 class="fw-bold mb-0">Payout Requests</h5>
    <small class="text-muted">Worker wallet withdrawal requests</small>
  </div>
</div>

<!-- Count Cards -->
<div class="row g-3 mb-4">
  <% [['all','','secondary'],['pending','warning','warning'],['approved','info','info'],['paid','success','success'],['rejected','danger','danger']].forEach(([s,c,col]) => { %>
    <div class="col-6 col-md">
      <a href="/admin/payout-requests<%= s!=='all'?'?status='+s:'' %>" class="text-decoration-none">
        <div class="card border-0 shadow-sm text-center p-3 <%= status===s||(s==='all'&&!status)?'border border-'+col:'' %>" style="<%= status===s||(s==='all'&&!status)?'border-width:2px!important;':'' %>">
          <div class="fw-bold fs-5 text-<%= col %>"><%= counts[s] %></div>
          <small class="text-muted text-capitalize" style="font-size:.7rem;"><%= s==='all'?'All':s %></small>
        </div>
      </a>
    </div>
  <% }) %>
</div>

<!-- Table -->
<div class="card border-0 shadow-sm">
  <div class="card-header d-flex align-items-center justify-content-between">
    <span><i class="bi bi-wallet2 me-2 text-primary"></i>
      <% if(status){ %><span class="text-capitalize"><%= status %></span> Requests<% } else { %>All Requests<% } %>
    </span>
    <span class="badge bg-primary rounded-pill"><%= requests.length %></span>
  </div>
  <div class="table-responsive">
    <table class="table table-hover mb-0">
      <thead class="table-light">
        <tr>
          <th>#</th>
          <th>Worker</th>
          <th>Bank Details</th>
          <th>Amount</th>
          <th>Note</th>
          <th>Status</th>
          <th>Requested</th>
          <th>Action</th>
        </tr>
      </thead>
      <tbody>
      <% requests.forEach(r => { %>
        <tr>
          <td class="text-muted small">#<%= r.id %></td>
          <td>
            <% if(r.Worker){ %>
              <a href="/admin/workers/<%= r.Worker.id %>" class="fw-semibold text-dark text-decoration-none"><%= r.Worker.name %></a>
              <div class="text-muted" style="font-size:.72rem;"><%= r.Worker.phone %></div>
            <% } else { %>—<% } %>
          </td>
          <td style="font-size:.75rem;">
            <% if(r.Worker && r.Worker.bank_name){ %>
              <div class="fw-semibold"><%= r.Worker.bank_name %></div>
              <div class="text-muted font-monospace"><%= r.Worker.account_number %></div>
              <div class="text-muted">IFSC: <%= r.Worker.ifsc_code %></div>
              <% if(r.Worker.holder_name){ %><div class="text-muted"><%= r.Worker.holder_name %></div><% } %>
            <% } else { %><span class="text-danger small">No bank details</span><% } %>
          </td>
          <td class="fw-bold text-success">₹<%= parseFloat(r.amount).toFixed(2) %></td>
          <td class="text-muted small"><%= r.note || '—' %></td>
          <td>
            <span class="badge bg-<%= sc[r.status]||'secondary' %>"><%= r.status %></span>
            <% if(r.admin_note){ %>
              <div class="text-muted mt-1" style="font-size:.68rem;" title="<%= r.admin_note %>">
                <i class="bi bi-chat-left-text me-1"></i><%= r.admin_note.length>30?r.admin_note.slice(0,30)+'…':r.admin_note %>
              </div>
            <% } %>
          </td>
          <td class="text-muted small"><%= new Date(r.created_at).toLocaleDateString('en-IN',{day:'2-digit',month:'short',year:'numeric'}) %></td>
          <td>
            <% if(r.status === 'pending' || r.status === 'approved'){ %>
              <button class="btn btn-sm btn-outline-primary" style="font-size:.72rem;"
                onclick="openAction(<%= r.id %>, '<%= r.status %>', '₹<%= parseFloat(r.amount).toFixed(2) %>', '<%= (r.Worker&&r.Worker.name)||'' %>')">
                <i class="bi bi-pencil-square me-1"></i>Action
              </button>
            <% } else { %>
              <span class="text-muted small"><%= r.processed_at ? new Date(r.processed_at).toLocaleDateString('en-IN',{day:'2-digit',month:'short'}) : '—' %></span>
            <% } %>
          </td>
        </tr>
      <% }) %>
      <% if(!requests.length){ %>
        <tr><td colspan="8" class="text-center py-5 text-muted">No payout requests found</td></tr>
      <% } %>
      </tbody>
    </table>
  </div>
</div>

<!-- Action Modal -->
<div class="modal fade" id="actionModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title"><i class="bi bi-wallet2 me-2 text-primary"></i>Process Payout</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <form id="actionForm" method="POST">
        <div class="modal-body">
          <p class="mb-3">Worker: <strong id="modalWorkerName"></strong> — <strong id="modalAmount" class="text-success"></strong></p>
          <div class="mb-3">
            <label class="form-label">Action</label>
            <select name="action" id="actionSelect" class="form-select" required>
              <option value="approved">Approve</option>
              <option value="paid">Mark as Paid</option>
              <option value="rejected">Reject (refunds wallet)</option>
            </select>
          </div>
          <div class="mb-1">
            <label class="form-label">Admin Note <span class="text-muted fw-normal">(optional)</span></label>
            <textarea name="admin_note" class="form-control" rows="2" placeholder="Reason or transaction ID…"></textarea>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-primary">Confirm</button>
        </div>
      </form>
    </div>
  </div>
</div>

<script>
function openAction(id, currentStatus, amount, workerName) {
  document.getElementById('actionForm').action = '/admin/payout-requests/' + id + '/process';
  document.getElementById('modalWorkerName').textContent = workerName;
  document.getElementById('modalAmount').textContent = amount;
  const sel = document.getElementById('actionSelect');
  // Pre-select logical next step
  sel.value = currentStatus === 'approved' ? 'paid' : 'approved';
  new bootstrap.Modal(document.getElementById('actionModal')).show();
}
</script>

<%- include('partials/footer') %>
