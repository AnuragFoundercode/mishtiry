<%- include('partials/header') %>

<% if(success&&success.length){ %><div class="alert alert-success">✅ <%= success %></div><% } %>
<% if(error&&error.length){ %><div class="alert alert-danger">⚠️ <%= error %></div><% } %>

<div class="d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center gap-2 mb-3">
  <div>
    <h5 class="mb-0 fw-bold">📄 Policies</h5>
    <small class="text-muted">Manage platform policies like Terms, Privacy, etc.</small>
  </div>
  <button class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#addPolicyModal">
    <i class="bi bi-plus-lg"></i> Add Policy
  </button>
</div>

<div class="card">
  <div class="card-body p-0">
    <% if(policies.length){ %>
      <div class="table-responsive">
        <table class="table table-hover mb-0">
          <thead class="table-light">
            <tr>
              <th>Title</th>
              <th>Slug</th>
              <th>Status</th>
              <th>Created</th>
              <th class="text-end">Actions</th>
            </tr>
          </thead>
          <tbody>
            <% policies.forEach(p => { %>
              <tr>
                <td class="fw-semibold"><%= p.title %></td>
                <td><code><%= p.slug %></code></td>
                <td><span class="badge bg-<%= p.is_active?'success':'secondary' %>"><%= p.is_active?'Active':'Inactive' %></span></td>
                <td><small class="text-muted"><%= formatDate(p.created_at || p.createdAt) %></small></td>
                <td class="text-end">
                  <button class="btn btn-sm btn-outline-primary" data-bs-toggle="modal" data-bs-target="#editPolicy<%= p.id %>">✏️ Edit</button>
                  <form method="POST" action="/admin/policies/<%= p.id %>/delete" class="d-inline" onsubmit="return confirm('Delete this policy?')">
                    <button class="btn btn-sm btn-outline-danger">🗑️ Delete</button>
                  </form>
                </td>
              </tr>

              <!-- Edit Policy Modal -->
              <div class="modal fade" id="editPolicy<%= p.id %>" tabindex="-1">
                <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
                  <div class="modal-content">
                    <div class="modal-header">
                      <h6 class="modal-title">✏️ Edit Policy: <%= p.title %></h6>
                      <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <form method="POST" action="/admin/policies/<%= p.id %>/update">
                      <div class="modal-body">
                        <div class="row g-3">
                          <div class="col-12 col-sm-8">
                            <label class="form-label">Title <span class="text-danger">*</span></label>
                            <input type="text" name="title" class="form-control" value="<%= p.title %>" required/>
                          </div>
                          <div class="col-12 col-sm-4">
                            <label class="form-label">Slug <span class="text-danger">*</span></label>
                            <input type="text" name="slug" class="form-control" value="<%= p.slug %>" required/>
                          </div>
                          <div class="col-12">
                            <label class="form-label">Content <span class="text-danger">*</span></label>
                            <textarea name="content" class="form-control" rows="10" required><%= p.content %></textarea>
                            <small class="text-muted">Supports HTML</small>
                          </div>
                          <div class="col-12">
                            <label class="form-label">Status</label>
                            <select name="is_active" class="form-select">
                              <option value="1" <%= p.is_active?'selected':'' %>>✅ Active</option>
                              <option value="0" <%= !p.is_active?'selected':'' %>>❌ Inactive</option>
                            </select>
                          </div>
                        </div>
                      </div>
                      <div class="modal-footer">
                        <button type="button" class="btn btn-light btn-sm" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-primary btn-sm">💾 Save</button>
                      </div>
                    </form>
                  </div>
                </div>
              </div>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } else { %>
      <div class="text-center py-5 text-muted">
        <div style="font-size:3rem">📄</div>
        <p class="mt-2 mb-0">No policies yet. Create your first policy!</p>
      </div>
    <% } %>
  </div>
</div>

<!-- Add Policy Modal -->
<div class="modal fade" id="addPolicyModal" tabindex="-1">
  <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
    <div class="modal-content">
      <div class="modal-header">
        <h6 class="modal-title">➕ Add New Policy</h6>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <form method="POST" action="/admin/policies">
        <div class="modal-body">
          <div class="row g-3">
            <div class="col-12 col-sm-8">
              <label class="form-label">Title <span class="text-danger">*</span></label>
              <input type="text" name="title" class="form-control" placeholder="e.g. Terms & Conditions" required/>
            </div>
            <div class="col-12 col-sm-4">
              <label class="form-label">Slug <span class="text-danger">*</span></label>
              <input type="text" name="slug" class="form-control" placeholder="e.g. terms" required/>
              <small class="text-muted">URL-friendly</small>
            </div>
            <div class="col-12">
              <label class="form-label">Content <span class="text-danger">*</span></label>
              <textarea name="content" class="form-control" rows="10" placeholder="Enter policy content here..." required></textarea>
              <small class="text-muted">Supports HTML</small>
            </div>
            <div class="col-12">
              <label class="form-label">Status</label>
              <select name="is_active" class="form-select">
                <option value="1" selected>✅ Active</option>
                <option value="0">❌ Inactive</option>
              </select>
            </div>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-light btn-sm" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-primary btn-sm">➕ Create Policy</button>
        </div>
      </form>
    </div>
  </div>
</div>

<%- include('partials/footer') %>
