<%- include('partials/header') %>

<% if(success&&success.length){ %><div class="alert alert-success alert-dismissible fade show" role="alert">
  <i class="bi bi-check-circle-fill me-2"></i><%= success %>
  <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
</div><% } %>
<% if(error&&error.length){ %><div class="alert alert-danger alert-dismissible fade show" role="alert">
  <i class="bi bi-exclamation-triangle-fill me-2"></i><%= error %>
  <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
</div><% } %>

<div class="d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center gap-3 mb-4">
  <div>
    <h4 class="mb-1 fw-bold text-dark">
      <i class="bi bi-geo-alt-fill text-primary me-2"></i>Service Zones
    </h4>
    <p class="text-muted mb-0 small">Manage delivery and service areas with polygon zones</p>
  </div>
  <button class="btn btn-primary d-flex align-items-center gap-2" onclick="startDrawing()">
    <i class="bi bi-plus-lg"></i>
    <span>Create New Zone</span>
  </button>
</div>

<div class="row g-3">
  <!-- Map -->
  <div class="col-lg-8">
    <div class="card border-0 shadow-sm">
      <div class="card-header bg-white border-bottom d-flex justify-content-between align-items-center">
        <h6 class="mb-0 fw-semibold text-dark">
          <i class="bi bi-map me-2 text-primary"></i>Zone Map
        </h6>
        <div class="d-flex gap-2">
          <button class="btn btn-sm btn-outline-secondary" onclick="map.setZoom(12)" title="Reset Zoom">
            <i class="bi bi-arrows-fullscreen"></i>
          </button>
          <button class="btn btn-sm btn-outline-primary" onclick="startDrawing()" title="Create Zone">
            <i class="bi bi-plus-lg"></i>
          </button>
        </div>
      </div>
      <div class="card-body p-0">
        <div id="map" style="height:600px;width:100%;"></div>
      </div>
    </div>
  </div>

  <!-- Zones List -->
  <div class="col-lg-4">
    <div class="card border-0 shadow-sm">
      <div class="card-header bg-white border-bottom">
        <h6 class="mb-0 fw-semibold text-dark">
          <i class="bi bi-list-ul me-2 text-primary"></i>Active Zones
        </h6>
      </div>
      <div class="card-body p-0" style="max-height:600px;overflow-y:auto;">
        <% if(zones.length){ %>
          <div class="list-group list-group-flush">
            <% zones.forEach(z => { %>
              <div class="list-group-item border-0 py-3">
                <div class="d-flex justify-content-between align-items-start">
                  <div class="flex-grow-1">
                    <div class="d-flex align-items-center gap-2 mb-2">
                      <div class="zone-color-indicator" style="width:12px;height:12px;border-radius:50%;background:<%= z.color %>;border:2px solid #fff;box-shadow:0 0 0 1px rgba(0,0,0,0.1);"></div>
                      <h6 class="mb-0 fw-semibold text-dark"><%= z.name %></h6>
                    </div>
                    <% if(z.coordinates && z.coordinates.length) { %>
                      <div class="d-flex align-items-center gap-1 mb-2">
                        <i class="bi bi-geo text-muted" style="font-size:12px;"></i>
                        <small class="text-muted"><%= z.coordinates.length %> coordinates</small>
                      </div>
                    <% } %>
                    <span class="badge <%= z.is_active ? 'bg-success' : 'bg-secondary' %> rounded-pill px-2 py-1">
                      <i class="bi <%= z.is_active ? 'bi-check-circle' : 'bi-pause-circle' %> me-1" style="font-size:10px;"></i>
                      <%= z.is_active ? 'Active' : 'Inactive' %>
                    </span>
                  </div>
                  <div class="dropdown">
                    <button class="btn btn-sm btn-outline-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown">
                      <i class="bi bi-three-dots-vertical"></i>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end">
                      <li>
                        <button class="dropdown-item d-flex align-items-center gap-2" onclick="focusZone(<%= z.id %>)">
                          <i class="bi bi-eye text-primary"></i>
                          <span>View on Map</span>
                        </button>
                      </li>
                      <li>
                        <button class="dropdown-item d-flex align-items-center gap-2" onclick="editZone(<%= z.id %>)">
                          <i class="bi bi-pencil text-warning"></i>
                          <span>Edit Zone</span>
                        </button>
                      </li>
                      <li><hr class="dropdown-divider"></li>
                      <li>
                        <form method="POST" action="/admin/zones/<%= z.id %>/delete" class="d-inline" onsubmit="return confirm('Are you sure you want to delete this zone?')">
                          <button type="submit" class="dropdown-item d-flex align-items-center gap-2 text-danger">
                            <i class="bi bi-trash"></i>
                            <span>Delete Zone</span>
                          </button>
                        </form>
                      </li>
                    </ul>
                  </div>
                </div>
              </div>
            <% }) %>
          </div>
        <% } else { %>
          <div class="text-center py-5">
            <div class="mb-3">
              <i class="bi bi-geo-alt text-muted" style="font-size:3rem;"></i>
            </div>
            <h6 class="text-muted mb-2">No zones created yet</h6>
            <p class="text-muted small mb-3">Create your first service zone to get started</p>
            <button class="btn btn-primary btn-sm" onclick="startDrawing()">
              <i class="bi bi-plus-lg me-1"></i>Create Zone
            </button>
          </div>
        <% } %>
      </div>
    </div>
  </div>
</div>

<!-- Zone Form Modal -->
<div class="modal fade" id="zoneModal" tabindex="-1">
  <div class="modal-dialog modal-lg modal-dialog-centered">
    <div class="modal-content border-0 shadow">
      <div class="modal-header bg-light border-bottom">
        <h5 class="modal-title fw-semibold" id="zoneModalTitle">
          <i class="bi bi-geo-alt-fill text-primary me-2"></i>Create Zone
        </h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <form id="zoneForm" method="POST" onsubmit="handleFormSubmit(event)">
        <div class="modal-body p-4">
          <div class="mb-4">
            <label class="form-label fw-semibold text-dark mb-2">
              <i class="bi bi-cursor-fill text-primary me-2"></i>Draw Zone on Map
            </label>
            <p class="text-muted small mb-3">Click on the map to place markers. Minimum 3 markers required to create a zone.</p>
            <div id="mapModal" class="border rounded" style="height:400px;width:100%;"></div>
          </div>
          
          <input type="hidden" name="coordinates" id="coordinates">
          
          <div class="row g-3">
            <div class="col-md-8">
              <label class="form-label fw-semibold text-dark">
                <i class="bi bi-tag-fill text-primary me-2"></i>Zone Name
                <span class="text-danger">*</span>
              </label>
              <input type="text" name="name" id="zone_name" class="form-control" placeholder="e.g. Downtown Area, North District" required/>
            </div>
            
            <div class="col-md-4">
              <label class="form-label fw-semibold text-dark">
                <i class="bi bi-palette-fill text-primary me-2"></i>Zone Color
              </label>
              <input type="color" name="color" id="zone_color" class="form-control form-control-color" value="#6c47ff"/>
            </div>
          </div>
          
          <div class="mt-3">
            <label class="form-label fw-semibold text-dark">
              <i class="bi bi-toggle-on text-primary me-2"></i>Status
            </label>
            <select name="is_active" id="zone_status" class="form-select">
              <option value="1" selected>
                <i class="bi bi-check-circle"></i> Active
              </option>
              <option value="0">
                <i class="bi bi-pause-circle"></i> Inactive
              </option>
            </select>
          </div>
          
          <div class="alert alert-info border-0 mt-4" role="alert">
            <div class="d-flex align-items-center">
              <i class="bi bi-info-circle-fill text-info me-2"></i>
              <div>
                <strong>Zone Requirements:</strong>
                <ul class="mb-0 mt-1 small">
                  <li>Minimum 3 coordinate points required</li>
                  <li>Click on map to place markers</li>
                  <li>Polygon will auto-generate after 3+ points</li>
                </ul>
              </div>
            </div>
          </div>
        </div>
        <div class="modal-footer bg-light border-top">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
            <i class="bi bi-x-lg me-1"></i>Cancel
          </button>
          <button type="submit" class="btn btn-primary" id="submitBtn" disabled>
            <i class="bi bi-check-lg me-1"></i>Save Zone
          </button>
        </div>
      </form>
    </div>
  </div>
</div>

<script src="https://maps.googleapis.com/maps/api/js?key=AIzaSyB0mG3CGok9-9RZau5J_VThUP4OTbQ_SFM"></script>

<script>
let map, mapModal, markers = [], polygon = null, editingZoneId = null, isDrawing = false;
const existingZones = <%- JSON.stringify(zones) %>;
const zoneData = {};
let mapInitialized = false, mapModalInitialized = false;

function initMap() {
  if (mapInitialized) return;
  
  map = new google.maps.Map(document.getElementById('map'), {
    center: { lat: 28.6139, lng: 77.2090 },
    zoom: 12,
    mapTypeControl: true,
    streetViewControl: false,
  });

  existingZones.forEach(zone => {
    // Store all zones in zoneData
    zoneData[zone.id] = zone;
    
    // Draw polygons for zones with valid coordinates
    if (zone.coordinates && Array.isArray(zone.coordinates) && zone.coordinates.length >= 3) {
      const coords = zone.coordinates.map(c => {
        const lat = typeof c.lat === 'string' ? parseFloat(c.lat) : c.lat;
        const lng = typeof c.lng === 'string' ? parseFloat(c.lng) : c.lng;
        return { lat, lng };
      });
      new google.maps.Polygon({
        paths: coords,
        strokeColor: zone.color || '#6c47ff',
        strokeOpacity: 0.8,
        strokeWeight: 2,
        fillColor: zone.color || '#6c47ff',
        fillOpacity: 0.2,
        map: map,
      });
    }
  });
  
  mapInitialized = true;
}

function initMapModal() {
  if (mapModalInitialized) return;
  const elem = document.getElementById('mapModal');
  if (!elem) return;
  
  mapModal = new google.maps.Map(elem, {
    center: { lat: 28.6139, lng: 77.2090 },
    zoom: 12,
    mapTypeControl: true,
    streetViewControl: false,
  });

  mapModal.addListener('click', (e) => {
    if (isDrawing) addMarkerModal(e.latLng);
  });
  
  mapModalInitialized = true;
}

function addMarkerModal(latLng) {
  const marker = new google.maps.Marker({
    position: latLng,
    map: mapModal,
    title: 'Marker ' + (markers.length + 1),
    icon: {
      path: google.maps.SymbolPath.CIRCLE,
      scale: 6,
      fillColor: document.getElementById('zone_color').value,
      fillOpacity: 0.8,
      strokeColor: '#fff',
      strokeWeight: 2,
    },
  });

  markers.push({ lat: latLng.lat(), lng: latLng.lng(), marker });
  updatePolygonModal();
  updateFormState();
}

function updatePolygonModal() {
  if (polygon) polygon.setMap(null);
  if (markers.length >= 3) {
    const coords = markers.map(m => ({ lat: m.lat, lng: m.lng }));
    polygon = new google.maps.Polygon({
      paths: coords,
      strokeColor: document.getElementById('zone_color').value,
      strokeOpacity: 0.8,
      strokeWeight: 2,
      fillColor: document.getElementById('zone_color').value,
      fillOpacity: 0.2,
      map: mapModal,
    });
  }
}

function updateFormState() {
  const hasMinMarkers = markers.length >= 3;
  document.getElementById('submitBtn').disabled = !hasMinMarkers;
}

function removeMarker(index) {
  markers[index].marker.setMap(null);
  markers.splice(index, 1);
  updatePolygonModal();
  updateFormState();
}

function clearAllMarkers() {
  markers.forEach(m => m.marker.setMap(null));
  markers = [];
  if (polygon) polygon.setMap(null);
  updateFormState();
}

function startDrawing() {
  console.log('startDrawing called');
  isDrawing = true;
  editingZoneId = null;
  document.getElementById('zoneModalTitle').textContent = 'Create Zone';
  document.getElementById('zoneForm').action = '/admin/zones';
  document.getElementById('zone_name').value = '';
  document.getElementById('zone_color').value = '#6c47ff';
  document.getElementById('zone_status').value = '1';
  
  clearAllMarkers();
  
  const modal = new bootstrap.Modal(document.getElementById('zoneModal'));
  modal.show();
  
  setTimeout(() => {
    mapModalInitialized = false;
    initMapModal();
    if (mapModal) google.maps.event.trigger(mapModal, 'resize');
  }, 500);
}

function editZone(zoneId) {
  console.log('editZone called for', zoneId);
  const zone = zoneData[zoneId];
  if (!zone) {
    console.error('Zone not found:', zoneId);
    return;
  }
  
  editingZoneId = zoneId;
  isDrawing = true;
  clearAllMarkers();
  
  document.getElementById('zoneModalTitle').textContent = 'Edit Zone';
  document.getElementById('zoneForm').action = '/admin/zones/' + zoneId + '/update';
  document.getElementById('zone_name').value = zone.name;
  document.getElementById('zone_color').value = zone.color || '#6c47ff';
  document.getElementById('zone_status').value = zone.is_active ? '1' : '0';
  
  const modal = new bootstrap.Modal(document.getElementById('zoneModal'));
  modal.show();
  
  setTimeout(() => {
    mapModalInitialized = false;
    initMapModal();
    if (mapModal) google.maps.event.trigger(mapModal, 'resize');
    
    if (zone.coordinates && Array.isArray(zone.coordinates)) {
      zone.coordinates.forEach(coord => {
        const lat = typeof coord.lat === 'string' ? parseFloat(coord.lat) : coord.lat;
        const lng = typeof coord.lng === 'string' ? parseFloat(coord.lng) : coord.lng;
        const latLng = new google.maps.LatLng(lat, lng);
        addMarkerModal(latLng);
      });
    }
  }, 500);
}

function focusZone(zoneId) {
  const zone = zoneData[zoneId];
  if (zone && zone.coordinates && zone.coordinates.length > 0) {
    const bounds = new google.maps.LatLngBounds();
    zone.coordinates.forEach(c => {
      const lat = typeof c.lat === 'string' ? parseFloat(c.lat) : c.lat;
      const lng = typeof c.lng === 'string' ? parseFloat(c.lng) : c.lng;
      bounds.extend({ lat, lng });
    });
    map.fitBounds(bounds);
  }
}

function handleFormSubmit(event) {
  event.preventDefault();
  
  if (markers.length < 3) {
    alert('Minimum 3 markers required');
    return;
  }
  
  const coordinatesData = markers.map(m => ({ lat: m.lat, lng: m.lng }));
  document.getElementById('coordinates').value = JSON.stringify(coordinatesData);
  document.getElementById('zoneForm').submit();
}

document.getElementById('zone_color').addEventListener('change', updatePolygonModal);

document.getElementById('zoneModal').addEventListener('hidden.bs.modal', function() {
  isDrawing = false;
  clearAllMarkers();
  editingZoneId = null;
});

window.addEventListener('load', () => {
  initMap();
  setTimeout(() => {
    if (map) google.maps.event.trigger(map, 'resize');
  }, 100);
});
</script>

<%- include('partials/footer') %>
