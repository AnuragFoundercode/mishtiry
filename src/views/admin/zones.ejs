<%- include('partials/header') %>

<% if(success&&success.length){ %><div class="alert alert-success">✅ <%= success %></div><% } %>
<% if(error&&error.length){ %><div class="alert alert-danger">⚠️ <%= error %></div><% } %>

<div class="d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center gap-2 mb-3">
  <div>
    <h5 class="mb-0 fw-bold">📍 Service Zones</h5>
    <small class="text-muted">Draw circular zones on map to define service areas</small>
  </div>
  <button class="btn btn-primary btn-sm" onclick="startDrawing()">
    <i class="bi bi-plus-circle"></i> Draw New Zone
  </button>
</div>

<div class="row g-3">
  <!-- Map -->
  <div class="col-lg-8">
    <div class="card">
      <div class="card-body p-0">
        <div id="map" style="height:600px;width:100%;"></div>
      </div>
    </div>
  </div>

  <!-- Zones List -->
  <div class="col-lg-4">
    <div class="card">
      <div class="card-header">Active Zones</div>
      <div class="card-body p-0" style="max-height:600px;overflow-y:auto;">
        <% if(zones.length){ %>
          <div class="list-group list-group-flush">
            <% zones.forEach(z => { %>
              <div class="list-group-item">
                <div class="d-flex justify-content-between align-items-start">
                  <div class="flex-grow-1">
                    <div class="d-flex align-items-center gap-2 mb-1">
                      <div style="width:16px;height:16px;border-radius:50%;background:<%= z.color %>;"></div>
                      <strong><%= z.name %></strong>
                    </div>
                    <small class="text-muted d-block">Radius: <%= z.radius_km %> km</small>
                    <small class="text-muted d-block">Center: <%= parseFloat(z.center_lat).toFixed(4) %>, <%= parseFloat(z.center_lng).toFixed(4) %></small>
                    <span class="badge bg-<%= z.is_active?'success':'secondary' %> mt-1"><%= z.is_active?'Active':'Inactive' %></span>
                  </div>
                  <div class="btn-group-vertical btn-group-sm">
                    <button class="btn btn-outline-primary" data-action="focus" data-lat="<%= z.center_lat %>" data-lng="<%= z.center_lng %>" title="Focus">
                      <i class="bi bi-geo-alt"></i>
                    </button>
                    <button class="btn btn-outline-warning" data-action="edit" data-id="<%= z.id %>" data-name="<%= z.name %>" data-lat="<%= z.center_lat %>" data-lng="<%= z.center_lng %>" data-radius="<%= z.radius_km %>" data-color="<%= z.color %>" data-active="<%= z.is_active %>" title="Edit">
                      <i class="bi bi-pencil"></i>
                    </button>
                    <form method="POST" action="/admin/zones/<%= z.id %>/delete" class="d-inline" onsubmit="return confirm('Delete this zone?')">
                      <button class="btn btn-outline-danger btn-sm" title="Delete">
                        <i class="bi bi-trash"></i>
                      </button>
                    </form>
                  </div>
                </div>
              </div>
            <% }) %>
          </div>
        <% } else { %>
          <div class="text-center py-5 text-muted">
            <div style="font-size:2rem">📍</div>
            <p class="mt-2 mb-0 small">No zones yet.<br>Click "Draw New Zone" to start</p>
          </div>
        <% } %>
      </div>
    </div>
  </div>
</div>

<!-- Zone Form Modal -->
<div class="modal fade" id="zoneModal" tabindex="-1">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header">
        <h6 class="modal-title" id="zoneModalTitle">Create Zone</h6>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <form id="zoneForm" method="POST">
        <div class="modal-body">
          <input type="hidden" name="center_lat" id="center_lat">
          <input type="hidden" name="center_lng" id="center_lng">
          <input type="hidden" name="radius_km" id="radius_km">
          
          <div class="mb-3">
            <label class="form-label">Zone Name <span class="text-danger">*</span></label>
            <input type="text" name="name" id="zone_name" class="form-control" placeholder="e.g. South Delhi Zone" required/>
          </div>
          
          <div class="mb-3">
            <label class="form-label">Radius (km) <span class="text-danger">*</span></label>
            <input type="number" name="radius_km_input" id="radius_km_input" class="form-control" step="0.1" min="0.5" max="50" value="5" required onchange="updateCircleRadius(this.value)"/>
            <small class="text-muted">Adjust radius on map or enter value</small>
          </div>
          
          <div class="mb-3">
            <label class="form-label">Color</label>
            <input type="color" name="color" id="zone_color" class="form-control form-control-color" value="#6c47ff"/>
          </div>
          
          <div class="mb-3">
            <label class="form-label">Status</label>
            <select name="is_active" id="zone_status" class="form-select">
              <option value="1" selected>✅ Active</option>
              <option value="0">❌ Inactive</option>
            </select>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-light btn-sm" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-primary btn-sm">💾 Save Zone</button>
        </div>
      </form>
    </div>
  </div>
</div>

<script src="https://maps.googleapis.com/maps/api/js?key=AIzaSyBFw0Qbyq9zTFTd-tUY6dZWTgaQzuU17R8&libraries=drawing,geometry"></script>
<script>
let map, drawingManager, currentCircle, editingZoneId = null;
const existingZones = <%- JSON.stringify(zones) %>;

function initMap() {
  // Center on India
  map = new google.maps.Map(document.getElementById('map'), {
    center: { lat: 28.6139, lng: 77.2090 }, // Delhi
    zoom: 11,
    mapTypeControl: true,
    streetViewControl: false,
  });

  // Draw existing zones
  existingZones.forEach(zone => {
    if (zone.center_lat && zone.center_lng && zone.radius_km) {
      new google.maps.Circle({
        map: map,
        center: { lat: parseFloat(zone.center_lat), lng: parseFloat(zone.center_lng) },
        radius: parseFloat(zone.radius_km) * 1000,
        fillColor: zone.color || '#6c47ff',
        fillOpacity: 0.2,
        strokeColor: zone.color || '#6c47ff',
        strokeWeight: 2,
        editable: false,
      });
    }
  });

  // Drawing manager
  drawingManager = new google.maps.drawing.DrawingManager({
    drawingMode: null,
    drawingControl: false,
    circleOptions: {
      fillColor: '#6c47ff',
      fillOpacity: 0.2,
      strokeWeight: 2,
      strokeColor: '#6c47ff',
      editable: true,
      draggable: true,
    }
  });
  drawingManager.setMap(map);

  google.maps.event.addListener(drawingManager, 'circlecomplete', function(circle) {
    currentCircle = circle;
    const center = circle.getCenter();
    const radius = circle.getRadius() / 1000; // meters to km
    
    document.getElementById('center_lat').value = center.lat();
    document.getElementById('center_lng').value = center.lng();
    document.getElementById('radius_km').value = radius.toFixed(2);
    document.getElementById('radius_km_input').value = radius.toFixed(2);
    
    drawingManager.setDrawingMode(null);
    new bootstrap.Modal(document.getElementById('zoneModal')).show();
    
    // Update on circle change
    google.maps.event.addListener(circle, 'radius_changed', function() {
      const newRadius = circle.getRadius() / 1000;
      document.getElementById('radius_km').value = newRadius.toFixed(2);
      document.getElementById('radius_km_input').value = newRadius.toFixed(2);
    });
    
    google.maps.event.addListener(circle, 'center_changed', function() {
      const newCenter = circle.getCenter();
      document.getElementById('center_lat').value = newCenter.lat();
      document.getElementById('center_lng').value = newCenter.lng();
    });
  });
}

function startDrawing() {
  if (currentCircle) currentCircle.setMap(null);
  drawingManager.setDrawingMode(google.maps.drawing.OverlayType.CIRCLE);
  editingZoneId = null;
  document.getElementById('zoneModalTitle').textContent = 'Create Zone';
  document.getElementById('zoneForm').action = '/admin/zones';
  document.getElementById('zone_name').value = '';
  document.getElementById('zone_color').value = '#6c47ff';
  document.getElementById('zone_status').value = '1';
}

function updateCircleRadius(km) {
  const radius = parseFloat(km);
  if (currentCircle && !isNaN(radius)) {
    currentCircle.setRadius(radius * 1000);
    document.getElementById('radius_km').value = radius.toFixed(2);
  }
}

function focusZone(lat, lng) {
  map.setCenter({ lat: parseFloat(lat), lng: parseFloat(lng) });
  map.setZoom(13);
}

function editZone(id, name, lat, lng, radius, color, isActive) {
  editingZoneId = id;
  document.getElementById('zoneModalTitle').textContent = 'Edit Zone';
  document.getElementById('zoneForm').action = `/admin/zones/${id}/update`;
  document.getElementById('zone_name').value = name || '';
  document.getElementById('center_lat').value = lat;
  document.getElementById('center_lng').value = lng;
  document.getElementById('radius_km').value = radius;
  document.getElementById('radius_km_input').value = radius;
  document.getElementById('zone_color').value = color || '#6c47ff';
  document.getElementById('zone_status').value = isActive ? '1' : '0';
  
  // Draw editable circle
  if (currentCircle) currentCircle.setMap(null);
  currentCircle = new google.maps.Circle({
    map: map,
    center: { lat: parseFloat(lat), lng: parseFloat(lng) },
    radius: parseFloat(radius) * 1000,
    fillColor: color,
    fillOpacity: 0.2,
    strokeWeight: 2,
    strokeColor: color,
    editable: true,
    draggable: true,
  });
  
  focusZone(lat, lng);
  new bootstrap.Modal(document.getElementById('zoneModal')).show();
  
  // Update on changes
  google.maps.event.addListener(currentCircle, 'radius_changed', function() {
    const newRadius = currentCircle.getRadius() / 1000;
    document.getElementById('radius_km').value = newRadius.toFixed(2);
    document.getElementById('radius_km_input').value = newRadius.toFixed(2);
  });
  
  google.maps.event.addListener(currentCircle, 'center_changed', function() {
    const newCenter = currentCircle.getCenter();
    document.getElementById('center_lat').value = newCenter.lat();
    document.getElementById('center_lng').value = newCenter.lng();
  });
}

// Initialize map on load
if (typeof google !== 'undefined') {
  window.onload = initMap;
} else {
  console.error('Google Maps API not loaded');
}

// Event delegation for zone actions
document.addEventListener('click', function(e) {
  const btn = e.target.closest('[data-action]');
  if (!btn) return;
  
  const action = btn.dataset.action;
  
  if (action === 'focus') {
    const lat = parseFloat(btn.dataset.lat);
    const lng = parseFloat(btn.dataset.lng);
    focusZone(lat, lng);
  } else if (action === 'edit') {
    const id = parseInt(btn.dataset.id);
    const name = btn.dataset.name;
    const lat = parseFloat(btn.dataset.lat);
    const lng = parseFloat(btn.dataset.lng);
    const radius = parseFloat(btn.dataset.radius);
    const color = btn.dataset.color;
    const isActive = btn.dataset.active === 'true';
    editZone(id, name, lat, lng, radius, color, isActive);
  }
});

// Clear circle on modal close
const zoneModalEl = document.getElementById('zoneModal');
if (zoneModalEl) {
  zoneModalEl.addEventListener('hidden.bs.modal', function() {
    if (currentCircle && !editingZoneId) {
      currentCircle.setMap(null);
      currentCircle = null;
    }
  });
}
</script>

<%- include('partials/footer') %>
