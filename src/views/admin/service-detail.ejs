<%- include('partials/header') %>

<div class="d-flex align-items-center gap-2 mb-4">
  <a href="/admin/services" class="btn btn-sm btn-outline-secondary">
    <i class="bi bi-arrow-left me-1"></i>Back
  </a>
  <h5 class="mb-0 fw-bold text-dark"><i class="bi bi-tools me-2 text-primary"></i><%= service.name %></h5>
  <span class="badge <%= service.is_active ? 'bg-success' : 'bg-secondary' %> rounded-pill ms-1">
    <%= service.is_active ? 'Active' : 'Inactive' %>
  </span>
</div>

<!-- Stats Row -->
<div class="row g-3 mb-4">
  <div class="col-6 col-lg-3">
    <div class="stat-card border-0 shadow-sm" style="background:linear-gradient(135deg,#6c47ff,#a855f7)">
      <div class="d-flex justify-content-between align-items-center">
        <div>
          <p class="text-white-50 mb-1 small fw-medium">Total Bookings</p>
          <h3 class="text-white mb-0 fw-bold"><%= totalBookings %></h3>
        </div>
        <i class="bi bi-calendar-check text-white-50" style="font-size:2rem;"></i>
      </div>
    </div>
  </div>
  <div class="col-6 col-lg-3">
    <div class="stat-card border-0 shadow-sm" style="background:linear-gradient(135deg,#10b981,#059669)">
      <div class="d-flex justify-content-between align-items-center">
        <div>
          <p class="text-white-50 mb-1 small fw-medium">Completed</p>
          <h3 class="text-white mb-0 fw-bold"><%= completedCount %></h3>
        </div>
        <i class="bi bi-check-circle text-white-50" style="font-size:2rem;"></i>
      </div>
    </div>
  </div>
  <div class="col-6 col-lg-3">
    <div class="stat-card border-0 shadow-sm" style="background:linear-gradient(135deg,#f59e0b,#d97706)">
      <div class="d-flex justify-content-between align-items-center">
        <div>
          <p class="text-white-50 mb-1 small fw-medium">Total Revenue</p>
          <h3 class="text-white mb-0 fw-bold">₹<%= parseFloat(totalRevenue).toFixed(0) %></h3>
        </div>
        <i class="bi bi-currency-rupee text-white-50" style="font-size:2rem;"></i>
      </div>
    </div>
  </div>
  <div class="col-6 col-lg-3">
    <div class="stat-card border-0 shadow-sm" style="background:linear-gradient(135deg,#3b82f6,#1d4ed8)">
      <div class="d-flex justify-content-between align-items-center">
        <div>
          <p class="text-white-50 mb-1 small fw-medium">Base Price</p>
          <h3 class="text-white mb-0 fw-bold">₹<%= parseFloat(service.price).toFixed(0) %></h3>
        </div>
        <i class="bi bi-tag text-white-50" style="font-size:2rem;"></i>
      </div>
    </div>
  </div>
</div>

<div class="row g-4">
  <!-- Service Info -->
  <div class="col-lg-4">
    <div class="card border-0 shadow-sm h-100">
      <div class="card-header bg-white border-bottom">
        <h6 class="mb-0 fw-semibold text-dark"><i class="bi bi-info-circle me-2 text-primary"></i>Service Details</h6>
      </div>
      <div class="card-body">
        <% const imgArr = Array.isArray(service.images) ? service.images : (typeof service.images === 'string' ? JSON.parse(service.images || '[]') : []); %>
        <% if(imgArr.length){ %>
          <div class="d-flex gap-2 flex-wrap mb-3">
            <% imgArr.forEach(img => { %>
              <img src="/uploads/<%= img %>" class="rounded" style="width:70px;height:70px;object-fit:cover"/>
            <% }) %>
          </div>
        <% } %>

        <table class="table table-sm table-borderless mb-0">
          <tr>
            <td class="text-muted fw-medium" style="width:40%">Category</td>
            <td><span class="badge bg-light text-dark border"><%= service.Category?.name || '—' %></span></td>
          </tr>
          <tr>
            <td class="text-muted fw-medium">Price</td>
            <td class="fw-bold text-dark">₹<%= parseFloat(service.price).toFixed(2) %></td>
          </tr>
          <% if(parseFloat(service.discount_percent) > 0){ %>
          <tr>
            <td class="text-muted fw-medium">Discount</td>
            <td><span class="badge bg-danger"><%= service.discount_percent %>% OFF</span></td>
          </tr>
          <tr>
            <td class="text-muted fw-medium">Final Price</td>
            <td class="fw-bold text-success">₹<%= parseFloat(service.final_price).toFixed(2) %></td>
          </tr>
          <% } %>
          <tr>
            <td class="text-muted fw-medium">Rating</td>
            <td>
              <% if(parseFloat(service.rating) > 0){ %>
                <span class="text-warning"><i class="bi bi-star-fill"></i></span> <%= service.rating %> <small class="text-muted">(<%= service.rating_count %> reviews)</small>
              <% } else { %>
                <span class="text-muted">No ratings yet</span>
              <% } %>
            </td>
          </tr>
          <tr>
            <td class="text-muted fw-medium">Est. Time</td>
            <td><%= service.estimated_time || '—' %></td>
          </tr>
          <tr>
            <td class="text-muted fw-medium">Status</td>
            <td>
              <span class="badge <%= service.is_active ? 'bg-success' : 'bg-secondary' %> rounded-pill">
                <%= service.is_active ? 'Active' : 'Inactive' %>
              </span>
            </td>
          </tr>
          <tr>
            <td class="text-muted fw-medium">Added On</td>
            <td class="small"><%= formatDate(service.created_at) %></td>
          </tr>
        </table>

        <% if(service.description){ %>
          <hr class="my-3"/>
          <p class="text-muted small mb-0"><%= service.description %></p>
        <% } %>

        <hr class="my-3"/>
        <form method="POST" action="/admin/services/<%= service.id %>/toggle">
          <button class="btn btn-sm w-100 <%= service.is_active ? 'btn-outline-warning' : 'btn-outline-success' %>">
            <i class="bi <%= service.is_active ? 'bi-pause-circle' : 'bi-check-circle' %> me-1"></i>
            <%= service.is_active ? 'Disable Service' : 'Enable Service' %>
          </button>
        </form>
      </div>
    </div>
  </div>

  <!-- Booking History -->
  <div class="col-lg-8">
    <!-- FAQs Section -->
    <% const detailFaqArr = Array.isArray(service.faqs) ? service.faqs : (typeof service.faqs === 'string' ? JSON.parse(service.faqs || '[]') : []); %>
    <% if(detailFaqArr.length){ %>
    <div class="card border-0 shadow-sm mb-4">
      <div class="card-header bg-white border-bottom">
        <h6 class="mb-0 fw-semibold text-dark"><i class="bi bi-question-circle me-2 text-primary"></i>FAQs</h6>
      </div>
      <div class="card-body">
        <div class="accordion accordion-flush" id="faqAccordion">
          <% detailFaqArr.forEach((faq, idx) => { %>
          <div class="accordion-item">
            <h2 class="accordion-header">
              <button class="accordion-button collapsed fw-medium" type="button" data-bs-toggle="collapse" data-bs-target="#faq<%= idx %>">
                <%= faq.question %>
              </button>
            </h2>
            <div id="faq<%= idx %>" class="accordion-collapse collapse" data-bs-parent="#faqAccordion">
              <div class="accordion-body text-muted"><%= faq.answer %></div>
            </div>
          </div>
          <% }) %>
        </div>
      </div>
    </div>
    <% } %>

    <!-- Includes Section -->
    <% const detailIncArr = Array.isArray(service.includes) ? service.includes : (typeof service.includes === 'string' ? JSON.parse(service.includes || '[]') : []); %>
    <% if(detailIncArr.length){ %>
    <div class="card border-0 shadow-sm mb-4">
      <div class="card-header bg-white border-bottom">
        <h6 class="mb-0 fw-semibold text-dark"><i class="bi bi-check-circle me-2 text-success"></i>Includes</h6>
      </div>
      <div class="card-body">
        <ul class="list-group list-group-flush">
          <% detailIncArr.forEach(item => { %>
          <li class="list-group-item px-0"><i class="bi bi-check2 text-success me-2"></i><%= item %></li>
          <% }) %>
        </ul>
      </div>
    </div>
    <% } %>

    <!-- How it's done Section -->
    <% const detailHowArr = Array.isArray(service.how_its_done) ? service.how_its_done : (typeof service.how_its_done === 'string' ? JSON.parse(service.how_its_done || '[]') : []); %>
    <% if(detailHowArr.length){ %>
    <div class="card border-0 shadow-sm mb-4">
      <div class="card-header bg-white border-bottom">
        <h6 class="mb-0 fw-semibold text-dark"><i class="bi bi-list-ol me-2 text-info"></i>How it's done?</h6>
      </div>
      <div class="card-body">
        <ol class="list-group list-group-numbered list-group-flush">
          <% detailHowArr.forEach(step => { %>
          <li class="list-group-item px-0"><%= step %></li>
          <% }) %>
        </ol>
      </div>
    </div>
    <% } %>

    <!-- Does not include Section -->
    <% const detailExcArr = Array.isArray(service.does_not_include) ? service.does_not_include : (typeof service.does_not_include === 'string' ? JSON.parse(service.does_not_include || '[]') : []); %>
    <% if(detailExcArr.length){ %>
    <div class="card border-0 shadow-sm mb-4">
      <div class="card-header bg-white border-bottom">
        <h6 class="mb-0 fw-semibold text-dark"><i class="bi bi-x-circle me-2 text-danger"></i>Does not include</h6>
      </div>
      <div class="card-body">
        <ul class="list-group list-group-flush">
          <% detailExcArr.forEach(item => { %>
          <li class="list-group-item px-0"><i class="bi bi-x text-danger me-2"></i><%= item %></li>
          <% }) %>
        </ul>
      </div>
    </div>
    <% } %>

    <div class="card border-0 shadow-sm">
      <div class="card-header bg-white border-bottom d-flex justify-content-between align-items-center">
        <h6 class="mb-0 fw-semibold text-dark">
          <i class="bi bi-calendar-check me-2 text-primary"></i>Booking History
        </h6>
        <span class="badge bg-primary"><%= totalBookings %> bookings</span>
      </div>
      <div class="table-responsive">
        <table class="table table-hover mb-0 align-middle">
          <thead class="table-light">
            <tr>
              <th>Booking ID</th>
              <th>Customer</th>
              <th>Date</th>
              <th>Amount</th>
              <th>Status</th>
              <th>Payment</th>
              <th></th>
            </tr>
          </thead>
          <tbody>
          <% bookings.forEach(b => { %>
            <tr>
              <td class="text-muted small fw-medium">#<%= b.id %></td>
              <td>
                <div class="fw-semibold text-dark"><%= b.User?.name || 'Unknown' %></div>
                <small class="text-muted"><%= b.User?.mobile || '' %></small>
              </td>
              <td class="small text-muted"><%= formatDate(b.booking_date) %></td>
              <td class="fw-bold">₹<%= parseFloat(b.total_amount || 0).toFixed(0) %></td>
              <td>
                <span class="badge rounded-pill <%=
                  b.status === 'completed'   ? 'bg-success' :
                  b.status === 'cancelled'   ? 'bg-danger'  :
                  b.status === 'in_progress' ? 'bg-info'    :
                  b.status === 'accepted'    ? 'bg-primary' : 'bg-warning text-dark'
                %>"><%= b.status.replace('_', ' ') %></span>
              </td>
              <td>
                <span class="badge rounded-pill <%= b.payment_status === 'paid' ? 'bg-success' : 'bg-secondary' %>">
                  <%= b.payment_status %>
                </span>
              </td>
              <td>
                <a href="/admin/bookings/<%= b.id %>" class="btn btn-sm btn-outline-primary">
                  <i class="bi bi-eye"></i>
                </a>
              </td>
            </tr>
          <% }) %>
          <% if(!bookings.length){ %>
            <tr>
              <td colspan="7" class="text-center py-5 text-muted">
                <i class="bi bi-calendar-x" style="font-size:2rem;"></i>
                <p class="mt-2 mb-0">No bookings yet for this service</p>
              </td>
            </tr>
          <% } %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>

<%- include('partials/footer') %>
