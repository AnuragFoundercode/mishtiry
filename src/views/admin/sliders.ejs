<%- include('partials/header') %>

<% if(success&&success.length){ %>
  <div class="alert alert-success alert-dismissible fade show" role="alert">
    <i class="bi bi-check-circle-fill me-2"></i><%= success %>
    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
  </div>
<% } %>
<% if(error&&error.length){ %>
  <div class="alert alert-danger alert-dismissible fade show" role="alert">
    <i class="bi bi-exclamation-triangle-fill me-2"></i><%= error %>
    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
  </div>
<% } %>

<div class="row g-4">
  <!-- Add Slider -->
  <div class="col-lg-4">
    <div class="card border-0 shadow-sm">
      <div class="card-header bg-white border-bottom">
        <h6 class="mb-0 fw-semibold text-dark">
          <i class="bi bi-plus-circle me-2 text-primary"></i>Add New Slider
        </h6>
      </div>
      <div class="card-body p-4">
        <form method="POST" action="/admin/sliders" enctype="multipart/form-data">
          <div class="mb-3">
            <label class="form-label fw-medium">Image <span class="text-danger">*</span></label>
            <input type="file" name="image" class="form-control" accept="image/*" required/>
            <div class="form-text">Recommended: 1200x400px</div>
          </div>
          <div class="mb-3">
            <label class="form-label fw-medium">Title</label>
            <input type="text" name="title" class="form-control" placeholder="Slider title"/>
          </div>
          <div class="mb-3">
            <label class="form-label fw-medium">Subtitle</label>
            <input type="text" name="subtitle" class="form-control" placeholder="Short description"/>
          </div>
          <div class="mb-3">
            <label class="form-label fw-medium">Show For <span class="text-danger">*</span></label>
            <select name="type" class="form-select" required>
              <option value="user">User App</option>
            </select>
          </div>
          <div class="mb-3">
            <label class="form-label fw-medium">Link <small class="text-muted">(optional)</small></label>
            <input type="text" name="link" class="form-control" placeholder="https://..."/>
          </div>
          <div class="mb-3">
            <label class="form-label fw-medium">Sort Order</label>
            <input type="number" name="sort_order" class="form-control" value="0" min="0"/>
          </div>
          <div class="mb-4">
            <label class="form-label fw-medium">Status</label>
            <select name="is_active" class="form-select">
              <option value="1">Active</option>
              <option value="0">Inactive</option>
            </select>
          </div>
          <button class="btn btn-primary w-100">
            <i class="bi bi-plus-lg me-1"></i>Add Slider
          </button>
        </form>
      </div>
    </div>
  </div>

  <!-- Sliders List -->
  <div class="col-lg-8">
    <div class="card border-0 shadow-sm">
      <div class="card-header bg-white border-bottom">
        <div class="d-flex justify-content-between align-items-center">
          <h6 class="mb-0 fw-semibold text-dark">
            <i class="bi bi-images me-2 text-primary"></i>All Sliders
          </h6>
          <span class="badge bg-primary"><%= sliders.length %> total</span>
        </div>
      </div>
      <div class="table-responsive">
        <table class="table table-hover mb-0 align-middle">
          <thead class="table-light">
            <tr><th>#</th><th>Image</th><th>Title</th><th>Type</th><th>Order</th><th>Status</th><th>Actions</th></tr>
          </thead>
          <tbody>
          <% sliders.forEach((s, i) => { %>
            <tr>
              <td class="text-muted small fw-medium"><%= i+1 %></td>
              <td>
                <img src="/uploads/<%= s.image %>" class="rounded" style="width:80px;height:40px;object-fit:cover"/>
              </td>
              <td>
                <div class="fw-semibold text-dark"><%= s.title || '—' %></div>
                <small class="text-muted"><%= s.subtitle || '' %></small>
              </td>
              <td>
                <span class="badge bg-info rounded-pill">User App</span>
              </td>
              <td><span class="badge bg-light text-dark border"><%= s.sort_order %></span></td>
              <td>
                <span class="badge <%= s.is_active ? 'bg-success' : 'bg-secondary' %> rounded-pill">
                  <%= s.is_active ? 'Active' : 'Inactive' %>
                </span>
              </td>
              <td>
                <div class="btn-group btn-group-sm">
                  <button class="btn btn-outline-primary" data-bs-toggle="modal" data-bs-target="#editSlider<%= s.id %>" title="Edit">
                    <i class="bi bi-pencil"></i>
                  </button>
                  <form method="POST" action="/admin/sliders/<%= s.id %>/delete" class="d-inline">
                    <button class="btn btn-outline-danger" onclick="return confirm('Delete this slider?')" title="Delete">
                      <i class="bi bi-trash"></i>
                    </button>
                  </form>
                </div>
              </td>
            </tr>

            <!-- Edit Modal -->
            <div class="modal fade" id="editSlider<%= s.id %>" tabindex="-1">
              <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content border-0 shadow">
                  <div class="modal-header bg-light border-bottom">
                    <h6 class="modal-title fw-semibold">
                      <i class="bi bi-pencil text-primary me-2"></i>Edit Slider
                    </h6>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                  </div>
                  <form method="POST" action="/admin/sliders/<%= s.id %>/update" enctype="multipart/form-data">
                    <div class="modal-body p-4">
                      <div class="mb-3">
                        <label class="form-label fw-medium">Current Image</label>
                        <img src="/uploads/<%= s.image %>" class="d-block rounded mb-2" style="height:60px;object-fit:cover"/>
                        <input type="file" name="image" class="form-control" accept="image/*"/>
                        <div class="form-text">Leave empty to keep current image</div>
                      </div>
                      <div class="mb-3">
                        <label class="form-label fw-medium">Title</label>
                        <input type="text" name="title" class="form-control" value="<%= s.title || '' %>"/>
                      </div>
                      <div class="mb-3">
                        <label class="form-label fw-medium">Subtitle</label>
                        <input type="text" name="subtitle" class="form-control" value="<%= s.subtitle || '' %>"/>
                      </div>
                      <div class="mb-3">
                        <label class="form-label fw-medium">Show For</label>
                        <select name="type" class="form-select">
                          <option value="user" selected>User App</option>
                        </select>
                      </div>
                      <div class="mb-3">
                        <label class="form-label fw-medium">Link</label>
                        <input type="text" name="link" class="form-control" value="<%= s.link || '' %>"/>
                      </div>
                      <div class="mb-3">
                        <label class="form-label fw-medium">Sort Order</label>
                        <input type="number" name="sort_order" class="form-control" value="<%= s.sort_order %>" min="0"/>
                      </div>
                      <div class="mb-3">
                        <label class="form-label fw-medium">Status</label>
                        <select name="is_active" class="form-select">
                          <option value="1" <%= s.is_active?'selected':'' %>>Active</option>
                          <option value="0" <%= !s.is_active?'selected':'' %>>Inactive</option>
                        </select>
                      </div>
                    </div>
                    <div class="modal-footer bg-light border-top">
                      <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                      <button type="submit" class="btn btn-primary">
                        <i class="bi bi-check-lg me-1"></i>Save Changes
                      </button>
                    </div>
                  </form>
                </div>
              </div>
            </div>
          <% }) %>
          <% if(!sliders.length){ %>
            <tr>
              <td colspan="7" class="text-center py-5">
                <div class="text-muted">
                  <i class="bi bi-images" style="font-size:2rem;"></i>
                  <p class="mt-2 mb-0">No sliders added yet</p>
                </div>
              </td>
            </tr>
          <% } %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>

<%- include('partials/footer') %>
