<%- include('partials/header') %>

<!-- Date Filter -->
<div class="card border-0 shadow-sm mb-4">
  <div class="card-body py-3">
    <form class="d-flex flex-wrap gap-3 align-items-end" method="GET">
      <div>
        <label class="form-label fw-medium mb-1 small">From Date</label>
        <input type="date" name="date_from" class="form-control form-control-sm" value="<%= date_from %>" style="width:160px"/>
      </div>
      <div>
        <label class="form-label fw-medium mb-1 small">To Date</label>
        <input type="date" name="date_to" class="form-control form-control-sm" value="<%= date_to %>" style="width:160px"/>
      </div>
      <div class="d-flex gap-2">
        <button class="btn btn-primary btn-sm"><i class="bi bi-funnel me-1"></i>Filter</button>
        <% if(date_from || date_to){ %>
          <a href="/admin/revenue" class="btn btn-outline-secondary btn-sm"><i class="bi bi-x-lg me-1"></i>Clear</a>
        <% } %>
      </div>
      <% if(date_from || date_to){ %>
        <div class="ms-auto">
          <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-3 py-2">
            <i class="bi bi-calendar-range me-1"></i>
            Filtered: <%= date_from || '...' %> → <%= date_to || '...' %>
          </span>
        </div>
      <% } %>
    </form>
  </div>
</div>

<!-- Revenue Cards -->
<div class="row g-3 mb-4">
  <div class="col-6 col-lg-4">
    <div class="stat-card border-0 shadow-sm" style="background:linear-gradient(135deg,#10b981,#059669)">
      <div class="d-flex justify-content-between align-items-center">
        <div>
          <p class="text-white-50 mb-1 small fw-medium">Total Revenue</p>
          <h3 class="text-white mb-0 fw-bold">₹<%= parseFloat(totalRevenue).toFixed(0) %></h3>
        </div>
        <i class="bi bi-graph-up-arrow text-white-50" style="font-size:2rem;"></i>
      </div>
    </div>
  </div>
  <div class="col-6 col-lg-4">
    <div class="stat-card border-0 shadow-sm" style="background:linear-gradient(135deg,#f59e0b,#d97706)">
      <div class="d-flex justify-content-between align-items-center">
        <div>
          <p class="text-white-50 mb-1 small fw-medium">Platform Charges</p>
          <h3 class="text-white mb-0 fw-bold">₹<%= parseFloat(totalPlatformCharge).toFixed(0) %></h3>
        </div>
        <i class="bi bi-credit-card text-white-50" style="font-size:2rem;"></i>
      </div>
    </div>
  </div>
  <div class="col-6 col-lg-4">
    <div class="stat-card border-0 shadow-sm" style="background:linear-gradient(135deg,#3b82f6,#1d4ed8)">
      <div class="d-flex justify-content-between align-items-center">
        <div>
          <p class="text-white-50 mb-1 small fw-medium">GST Collected</p>
          <h3 class="text-white mb-0 fw-bold">₹<%= parseFloat(totalGst).toFixed(0) %></h3>
        </div>
        <i class="bi bi-receipt text-white-50" style="font-size:2rem;"></i>
      </div>
    </div>
  </div>
</div>

<!-- Platform Settings -->
<div class="card border-0 shadow-sm mb-4">
  <div class="card-header bg-white border-bottom d-flex justify-content-between align-items-center">
    <h6 class="mb-0 fw-semibold text-dark"><i class="bi bi-gear me-2 text-primary"></i>Current Platform Config</h6>
    <a href="/admin/settings" class="btn btn-sm btn-outline-primary"><i class="bi bi-pencil me-1"></i>Edit</a>
  </div>
  <div class="card-body">
    <div class="row g-3">
      <div class="col-6 col-lg-3">
        <div class="p-3 rounded-3 bg-primary bg-opacity-10">
          <i class="bi bi-credit-card text-primary" style="font-size:1.5rem;"></i>
          <h5 class="mb-0 fw-bold text-dark mt-2"><%= settings.platform_charge_percent %>%</h5>
          <small class="text-muted">Platform Charge</small>
        </div>
      </div>
      <div class="col-6 col-lg-3">
        <div class="p-3 rounded-3 bg-success bg-opacity-10">
          <i class="bi bi-receipt text-success" style="font-size:1.5rem;"></i>
          <h5 class="mb-0 fw-bold text-dark mt-2"><%= settings.gst_percent %>%</h5>
          <small class="text-muted">GST</small>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Recent Paid Bookings -->
<div class="card border-0 shadow-sm">
  <div class="card-header bg-white border-bottom d-flex justify-content-between align-items-center">
    <h6 class="mb-0 fw-semibold text-dark">
      <i class="bi bi-credit-card me-2 text-primary"></i>Paid Bookings
      <% if(date_from || date_to){ %>
        <small class="text-muted fw-normal ms-1">(filtered)</small>
      <% } %>
    </h6>
    <span class="badge bg-primary"><%= recentPaid.length %> records</span>
  </div>
  <div class="table-responsive">
    <table class="table table-hover mb-0 align-middle">
      <thead class="table-light">
        <tr>
          <th>ID</th><th>Customer</th><th>Service</th>
          <th>Base</th><th>Platform</th><th>GST</th><th>Total</th>
        </tr>
      </thead>
      <tbody>
      <% recentPaid.forEach(b => { %>
        <tr>
          <td><a href="/admin/bookings/<%= b.id %>" class="text-decoration-none text-muted small fw-medium">#<%= b.id %></a></td>
          <td class="fw-medium"><%= b.User?.name || '—' %></td>
          <td><%= b.Service?.name || '—' %></td>
          <td class="fw-semibold">₹<%= parseFloat(b.amount || 0).toFixed(0) %></td>
          <td class="text-warning fw-semibold">₹<%= parseFloat(b.platform_charge || 0).toFixed(0) %></td>
          <td class="text-info fw-semibold">₹<%= parseFloat(b.gst_amount || 0).toFixed(0) %></td>
          <td class="fw-bold text-dark">₹<%= parseFloat(b.total_amount || 0).toFixed(0) %></td>
        </tr>
      <% }) %>
      <% if(!recentPaid.length){ %>
        <tr>
          <td colspan="7" class="text-center py-5 text-muted">
            <i class="bi bi-credit-card" style="font-size:2rem;"></i>
            <p class="mt-2 mb-0">No paid bookings<%= date_from || date_to ? ' in selected date range' : '' %></p>
          </td>
        </tr>
      <% } %>
      </tbody>
    </table>
  </div>
</div>

<%- include('partials/footer') %>
