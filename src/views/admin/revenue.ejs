<%- include('partials/header') %>

<!-- Revenue Cards -->
<div class="row g-3 mb-4">
  <div class="col-6 col-lg-3">
    <div class="stat-card" style="background:linear-gradient(135deg,#10b981,#059669)">
      <p>💰 Total Revenue</p><h3>₹<%= parseFloat(totalRevenue).toFixed(0) %></h3>
      <i class="bi bi-currency-rupee icon"></i>
    </div>
  </div>
  <div class="col-6 col-lg-3">
    <div class="stat-card" style="background:linear-gradient(135deg,#6c47ff,#a855f7)">
      <p>💸 Commission</p><h3>₹<%= parseFloat(totalCommission).toFixed(0) %></h3>
      <i class="bi bi-percent icon"></i>
    </div>
  </div>
  <div class="col-6 col-lg-3">
    <div class="stat-card" style="background:linear-gradient(135deg,#f59e0b,#d97706)">
      <p>🏷️ Platform Charges</p><h3>₹<%= parseFloat(totalPlatformCharge).toFixed(0) %></h3>
      <i class="bi bi-tag-fill icon"></i>
    </div>
  </div>
  <div class="col-6 col-lg-3">
    <div class="stat-card" style="background:linear-gradient(135deg,#3b82f6,#1d4ed8)">
      <p>🧾 GST Collected</p><h3>₹<%= parseFloat(totalGst).toFixed(0) %></h3>
      <i class="bi bi-receipt icon"></i>
    </div>
  </div>
</div>

<div class="row g-3 mb-4">
  <!-- Revenue by Model -->
  <div class="col-lg-5">
    <div class="card h-100">
      <div class="card-header">📊 Revenue by Model</div>
      <div class="card-body">
        <% if(byModel.length){ byModel.forEach(m => { %>
          <div class="d-flex justify-content-between align-items-center mb-3">
            <div>
              <% const icons={commission:'💸',subscription:'📦',hybrid:'🔀'}; %>
              <span class="fw-semibold"><%= icons[m.revenue_model_applied]||'📋' %> <%= m.revenue_model_applied||'Unknown' %></span>
              <br><small class="text-muted"><%= m.count %> bookings</small>
            </div>
            <div class="text-end">
              <div class="fw-bold text-success">₹<%= parseFloat(m.total||0).toFixed(2) %></div>
              <small class="text-muted">commission</small>
            </div>
          </div>
          <div class="progress mb-3" style="height:6px">
            <div class="progress-bar bg-success" style="width:<%= totalCommission>0?(m.total/totalCommission*100).toFixed(0):0 %>%"></div>
          </div>
        <% }) } else { %>
          <p class="text-muted text-center py-4">No paid bookings yet</p>
        <% } %>
      </div>
    </div>
  </div>

  <!-- Platform Settings Summary -->
  <div class="col-lg-7">
    <div class="card h-100">
      <div class="card-header d-flex justify-content-between align-items-center">
        <span>⚙️ Current Platform Config</span>
        <a href="/admin/settings" class="btn btn-sm btn-outline-primary">Edit</a>
      </div>
      <div class="card-body">
        <div class="row g-3">
          <div class="col-6">
            <div class="p-3 rounded-3" style="background:#f8f8ff">
              <div style="font-size:1.5rem">🏷️</div>
              <h5 class="mb-0 fw-bold mt-1"><%= settings.platform_charge_percent %>%</h5>
              <small class="text-muted">Platform Charge</small>
            </div>
          </div>
          <div class="col-6">
            <div class="p-3 rounded-3" style="background:#f8fff8">
              <div style="font-size:1.5rem">🧾</div>
              <h5 class="mb-0 fw-bold mt-1"><%= settings.gst_percent %>%</h5>
              <small class="text-muted">GST on Platform Charge</small>
            </div>
          </div>
          <div class="col-6">
            <div class="p-3 rounded-3" style="background:#fff8f0">
              <div style="font-size:1.5rem">💸</div>
              <h5 class="mb-0 fw-bold mt-1"><%= settings.default_commission_percent %>%</h5>
              <small class="text-muted">Default Commission</small>
            </div>
          </div>
          <div class="col-6">
            <div class="p-3 rounded-3" style="background:#f0f8ff">
              <div style="font-size:1.5rem">🔀</div>
              <h5 class="mb-0 fw-bold mt-1 text-capitalize"><%= settings.default_revenue_model %></h5>
              <small class="text-muted">Default Revenue Model</small>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Recent Paid Bookings -->
<div class="card">
  <div class="card-header">💳 Recent Paid Bookings</div>
  <div class="table-responsive">
    <table class="table table-hover mb-0">
      <thead><tr><th>#ID</th><th>User</th><th>Vendor</th><th>Service</th><th>Base</th><th>Platform Fee</th><th>GST</th><th>Total</th><th>Commission</th><th>Vendor Gets</th></tr></thead>
      <tbody>
      <% recentPaid.forEach(b => { %>
        <tr>
          <td class="text-muted small">#<%= b.id %></td>
          <td><%= b.User?.name||'—' %></td>
          <td><%= b.Vendor?.business_name||'—' %></td>
          <td><%= b.Service?.name||'—' %></td>
          <td>₹<%= parseFloat(b.amount||0).toFixed(0) %></td>
          <td class="text-warning">₹<%= parseFloat(b.platform_charge||0).toFixed(0) %></td>
          <td class="text-info">₹<%= parseFloat(b.gst_amount||0).toFixed(0) %></td>
          <td class="fw-bold">₹<%= parseFloat(b.total_amount||0).toFixed(0) %></td>
          <td class="text-success">₹<%= parseFloat(b.commission_amount||0).toFixed(0) %> (<%= b.commission_percent_applied||0 %>%)</td>
          <td class="text-primary fw-semibold">₹<%= parseFloat(b.vendor_payout||0).toFixed(0) %></td>
        </tr>
      <% }) %>
      <% if(!recentPaid.length){ %><tr><td colspan="10" class="text-center text-muted py-4">No paid bookings yet</td></tr><% } %>
      </tbody>
    </table>
  </div>
</div>

<%- include('partials/footer') %>
