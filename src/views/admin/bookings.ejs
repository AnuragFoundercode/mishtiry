<%- include('partials/header') %>

<% if(success&&success.length){ %>
  <div class="alert alert-success alert-dismissible fade show" role="alert">
    <i class="bi bi-check-circle-fill me-2"></i><%= success %>
    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
  </div>
<% } %>

<div class="card border-0 shadow-sm">
  <div class="card-header bg-white border-bottom">
    <div class="d-flex flex-wrap gap-3 justify-content-between align-items-center">
      <div>
        <h5 class="mb-1 fw-bold text-dark">
          <i class="bi bi-calendar-check me-2 text-primary"></i>Bookings Management
        </h5>
        <p class="text-muted small mb-0">Total: <span class="badge bg-primary"><%= total %></span> bookings</p>
      </div>
      <form class="d-flex gap-2" method="GET" action="/admin/bookings">
        <input type="hidden" name="status" value="<%= status %>">
        <div class="input-group">
          <span class="input-group-text bg-light border-end-0"><i class="bi bi-search text-muted"></i></span>
          <input type="text" name="search" class="form-control border-start-0" placeholder="Booking ID, name or mobile" value="<%= search %>" style="width:220px">
        </div>
        <button class="btn btn-primary btn-sm"><i class="bi bi-search"></i></button>
        <% if(search){ %><a href="/admin/bookings?status=<%= status %>" class="btn btn-outline-secondary btn-sm"><i class="bi bi-x-lg"></i></a><% } %>
      </form>
      <div class="btn-group" role="group">
        <a href="/admin/bookings" class="btn btn-sm <%= !status?'btn-primary':'btn-outline-secondary' %>">All</a>
        <a href="/admin/bookings?status=pending" class="btn btn-sm <%= status==='pending'?'btn-warning':'btn-outline-warning' %>">
          <i class="bi bi-clock-history me-1"></i>Pending
        </a>
        <a href="/admin/bookings?status=accepted" class="btn btn-sm <%= status==='accepted'?'btn-info':'btn-outline-info' %>">
          <i class="bi bi-check-circle me-1"></i>Accepted
        </a>
        <a href="/admin/bookings?status=in_progress" class="btn btn-sm <%= status==='in_progress'?'btn-primary':'btn-outline-primary' %>">
          <i class="bi bi-arrow-repeat me-1"></i>In Progress
        </a>
        <a href="/admin/bookings?status=completed" class="btn btn-sm <%= status==='completed'?'btn-success':'btn-outline-success' %>">
          <i class="bi bi-check-circle-fill me-1"></i>Completed
        </a>
        <a href="/admin/bookings?status=cancelled" class="btn btn-sm <%= status==='cancelled'?'btn-danger':'btn-outline-danger' %>">
          <i class="bi bi-x-circle me-1"></i>Cancelled
        </a>
      </div>
    </div>
  </div>
  <div class="table-responsive">
    <table class="table table-hover mb-0">
      <thead class="table-light">
        <tr><th>Booking ID</th><th>Customer</th><th>Vendor</th><th>Service</th><th>Date</th><th>Amount</th><th>Commission</th><th>Status</th><th>Payment</th><th>Action</th></tr>
      </thead>
      <tbody>
      <% bookings.forEach(b => { %>
        <tr>
          <td class="text-muted small fw-medium">#<%= b.id %></td>
          <td>
            <div class="d-flex align-items-center gap-2">
              <div class="bg-primary bg-opacity-10 rounded-circle p-2">
                <i class="bi bi-person-fill text-primary" style="font-size:12px;"></i>
              </div>
              <div>
                <div class="fw-medium"><%= b.User?.name||'—' %></div>
                <small class="text-muted"><i class="bi bi-phone me-1"></i><%= b.User?.mobile %></small>
              </div>
            </div>
          </td>
          <td>
            <div class="d-flex align-items-center gap-1">
              <i class="bi bi-shop text-muted" style="font-size:12px;"></i>
              <span class="fw-medium"><%= b.Vendor?.business_name||'—' %></span>
            </div>
          </td>
          <td>
            <div class="d-flex align-items-center gap-1">
              <i class="bi bi-tools text-muted" style="font-size:12px;"></i>
              <span><%= b.Service?.name||'—' %></span>
            </div>
          </td>
          <td class="small text-muted">
            <i class="bi bi-calendar3 me-1"></i><%= formatDate(b.booking_date) %>
          </td>
          <td>
            <div class="fw-semibold text-dark">₹<%= parseFloat(b.total_amount||0).toFixed(0) %></div>
            <small class="text-muted">Base: ₹<%= parseFloat(b.amount||0).toFixed(0) %></small>
          </td>
          <td>
            <div class="text-success fw-semibold">₹<%= parseFloat(b.commission_amount||0).toFixed(0) %></div>
            <small class="text-muted"><%= b.commission_percent_applied||0 %>%</small>
          </td>
          <td>
            <% const sc={pending:'warning',accepted:'info',in_progress:'primary',completed:'success',cancelled:'danger'}; %>
            <span class="badge bg-<%= sc[b.status]||'secondary' %> rounded-pill">
              <% if(b.status === 'pending'){ %><i class="bi bi-clock-history me-1" style="font-size:10px;"></i>
              <% } else if(b.status === 'accepted'){ %><i class="bi bi-check-circle me-1" style="font-size:10px;"></i>
              <% } else if(b.status === 'in_progress'){ %><i class="bi bi-arrow-repeat me-1" style="font-size:10px;"></i>
              <% } else if(b.status === 'completed'){ %><i class="bi bi-check-circle-fill me-1" style="font-size:10px;"></i>
              <% } else if(b.status === 'cancelled'){ %><i class="bi bi-x-circle me-1" style="font-size:10px;"></i><% } %>
              <%= b.status %>
            </span>
          </td>
          <td>
            <% const pc={pending:'secondary',paid:'success',refunded:'warning'}; %>
            <span class="badge bg-<%= pc[b.payment_status]||'secondary' %> rounded-pill"><%= b.payment_status %></span>
          </td>
          <td>
            <a href="/admin/bookings/<%= b.id %>" class="btn btn-sm btn-outline-primary">
              <i class="bi bi-eye me-1"></i>View
            </a>
          </td>
        </tr>
      <% }) %>
      <% if(!bookings.length){ %>
        <tr>
          <td colspan="9" class="text-center py-5">
            <div class="text-muted">
              <i class="bi bi-calendar-check" style="font-size:2rem;"></i>
              <p class="mt-2 mb-0">No bookings found</p>
              <% if(status){ %>
                <small>No bookings with status: <%= status %></small>
              <% } %>
            </div>
          </td>
        </tr>
      <% } %>
      </tbody>
    </table>
  </div>
  <% if(pages>1){ %>
  <div class="card-footer d-flex justify-content-between align-items-center">
    <small class="text-muted">Showing <%= (currentPage-1)*15+1 %>–<%= Math.min(currentPage*15,total) %> of <%= total %></small>
    <nav><ul class="pagination pagination-sm mb-0">
      <% for(let p=1;p<=pages;p++){ %>
        <li class="page-item <%= p==currentPage?'active':'' %>"><a class="page-link" href="?page=<%= p %>&status=<%= status %>&search=<%= search %>"><%= p %></a></li>
      <% } %>
    </ul></nav>
  </div>
  <% } %>
</div>

<%- include('partials/footer') %>
