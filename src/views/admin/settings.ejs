<%- include('partials/header') %>

<% if(success&&success.length){ %>
  <div class="alert alert-success alert-dismissible fade show" role="alert">
    <i class="bi bi-check-circle-fill me-2"></i><%= success %>
    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
  </div>
<% } %>
<% if(error&&error.length){ %>
  <div class="alert alert-danger alert-dismissible fade show" role="alert">
    <i class="bi bi-exclamation-triangle-fill me-2"></i><%= error %>
    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
  </div>
<% } %>

<div class="row g-4">
  <div class="col-lg-8">
    <div class="card border-0 shadow-sm">
      <div class="card-header bg-white border-bottom">
        <h5 class="mb-1 fw-bold text-dark">
          <i class="bi bi-gear me-2 text-primary"></i>Platform Configuration
        </h5>
        <p class="text-muted small mb-0">Configure revenue model and pricing structure</p>
      </div>
      <div class="card-body p-4">
        <div class="alert alert-info border-0 mb-4" role="alert">
          <div class="d-flex align-items-start">
            <i class="bi bi-info-circle-fill text-info me-3 mt-1"></i>
            <div>
              <h6 class="alert-heading mb-2">How Platform Charges Work</h6>
              <ul class="mb-0 small">
                <li><strong>Platform Charge:</strong> Added on top of service price (paid by customer)</li>
                <li><strong>GST:</strong> Calculated only on platform charge amount</li>
                <li><strong>Commission:</strong> Deducted from vendor's service price</li>
              </ul>
            </div>
          </div>
        </div>
        
        <form method="POST" action="/admin/settings">
          <div class="row g-4">
            <div class="col-md-6">
              <div class="form-group">
                <label class="form-label fw-semibold text-dark mb-2">
                  <i class="bi bi-credit-card text-primary me-2"></i>Platform Charge
                </label>
                <div class="input-group">
                  <input type="number" name="platform_charge_percent" class="form-control" step="0.01" min="0" max="100" value="<%= settings.platform_charge_percent %>" required/>
                  <span class="input-group-text bg-light">%</span>
                </div>
                <div class="form-text">Fee charged to customers on every booking</div>
              </div>
            </div>
            
            <div class="col-md-6">
              <div class="form-group">
                <label class="form-label fw-semibold text-dark mb-2">
                  <i class="bi bi-receipt text-primary me-2"></i>GST Rate
                </label>
                <div class="input-group">
                  <input type="number" name="gst_percent" class="form-control" step="0.01" min="0" max="100" value="<%= settings.gst_percent %>" required/>
                  <span class="input-group-text bg-light">%</span>
                </div>
                <div class="form-text">Applied only on platform charge amount</div>
              </div>
            </div>
            
            <div class="col-md-6">
              <div class="form-group">
                <label class="form-label fw-semibold text-dark mb-2">
                  <i class="bi bi-percent text-primary me-2"></i>Default Commission
                </label>
                <div class="input-group">
                  <input type="number" name="default_commission_percent" class="form-control" step="0.01" min="0" max="100" value="<%= settings.default_commission_percent %>" required/>
                  <span class="input-group-text bg-light">%</span>
                </div>
                <div class="form-text">Used for vendors without custom rates</div>
              </div>
            </div>
            
            <div class="col-md-6">
              <div class="form-group">
                <label class="form-label fw-semibold text-dark mb-2">
                  <i class="bi bi-shuffle text-primary me-2"></i>Default Revenue Model
                </label>
                <select name="default_revenue_model" class="form-select" required>
                  <option value="commission" <%= settings.default_revenue_model==='commission'?'selected':'' %>>
                    Commission Based
                  </option>
                  <option value="subscription" <%= settings.default_revenue_model==='subscription'?'selected':'' %>>
                    Subscription Based
                  </option>
                  <option value="hybrid" <%= settings.default_revenue_model==='hybrid'?'selected':'' %>>
                    Hybrid Model
                  </option>
                </select>
                <div class="form-text">Default model for new vendors</div>
              </div>
            </div>
            
            <div class="col-12">
              <div class="d-flex gap-2 pt-3">
                <button type="submit" class="btn btn-primary px-4">
                  <i class="bi bi-check-lg me-2"></i>Save Configuration
                </button>
                <button type="button" class="btn btn-outline-secondary" onclick="location.reload()">
                  <i class="bi bi-arrow-clockwise me-2"></i>Reset
                </button>
              </div>
            </div>
          </div>
        </form>
      </div>
    </div>
  </div>

  <div class="col-lg-4">
    <!-- Live Preview Calculator -->
    <div class="card border-0 shadow-sm mb-4">
      <div class="card-header bg-white border-bottom">
        <h6 class="mb-0 fw-semibold text-dark">
          <i class="bi bi-calculator me-2 text-primary"></i>Pricing Calculator
        </h6>
      </div>
      <div class="card-body p-4">
        <div class="mb-3">
          <label class="form-label fw-semibold text-dark mb-2">Service Price (₹)</label>
          <input type="number" id="previewPrice" class="form-control" value="1000" oninput="calcPreview()" placeholder="Enter amount"/>
        </div>
        <div id="previewResult" class="mt-3"></div>
      </div>
    </div>

    <!-- Quick Actions -->
    <div class="card border-0 shadow-sm">
      <div class="card-header bg-white border-bottom">
        <h6 class="mb-0 fw-semibold text-dark">
          <i class="bi bi-lightning me-2 text-primary"></i>Quick Actions
        </h6>
      </div>
      <div class="card-body p-4">
        <div class="d-grid gap-3">
          <button class="btn btn-outline-primary d-flex align-items-center justify-content-between" data-bs-toggle="modal" data-bs-target="#changePwdModal">
            <div class="d-flex align-items-center">
              <i class="bi bi-key me-3 text-primary"></i>
              <div class="text-start">
                <div class="fw-semibold">Change Password</div>
                <small class="text-muted">Update admin credentials</small>
              </div>
            </div>
            <i class="bi bi-arrow-right text-muted"></i>
          </button>
          
          <a href="/admin/revenue" class="btn btn-outline-success d-flex align-items-center justify-content-between text-decoration-none">
            <div class="d-flex align-items-center">
              <i class="bi bi-graph-up-arrow me-3 text-success"></i>
              <div class="text-start">
                <div class="fw-semibold">View Revenue</div>
                <small class="text-muted">Check earnings & analytics</small>
              </div>
            </div>
            <i class="bi bi-arrow-right text-muted"></i>
          </a>
          
          <a href="/admin/vendors" class="btn btn-outline-info d-flex align-items-center justify-content-between text-decoration-none">
            <div class="d-flex align-items-center">
              <i class="bi bi-shop me-3 text-info"></i>
              <div class="text-start">
                <div class="fw-semibold">Manage Vendors</div>
                <small class="text-muted">Vendor pricing & settings</small>
              </div>
            </div>
            <i class="bi bi-arrow-right text-muted"></i>
          </a>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
const pc = parseFloat('<%= settings.platform_charge_percent %>');
const gc = parseFloat('<%= settings.gst_percent %>');
const cc = parseFloat('<%= settings.default_commission_percent %>');

function calcPreview() {
  const price = parseFloat(document.getElementById('previewPrice').value) || 0;
  const platformCharge = +(price * pc / 100).toFixed(2);
  const gst = +(platformCharge * gc / 100).toFixed(2);
  const total = +(price + platformCharge + gst).toFixed(2);
  const commission = +(price * cc / 100).toFixed(2);
  const vendorPayout = +(price - commission).toFixed(2);
  
  document.getElementById('previewResult').innerHTML = `
    <div class="bg-light rounded-3 p-3">
      <h6 class="fw-bold mb-3 text-dark">Breakdown for ₹${price.toFixed(0)}</h6>
      <div class="row g-2 small">
        <div class="col-12 d-flex justify-content-between py-1">
          <span class="text-muted"><i class="bi bi-tag me-1"></i>Service Price:</span>
          <span class="fw-semibold">₹${price.toFixed(2)}</span>
        </div>
        <div class="col-12 d-flex justify-content-between py-1">
          <span class="text-muted"><i class="bi bi-credit-card me-1"></i>Platform Charge (${pc}%):</span>
          <span class="text-warning fw-semibold">+ ₹${platformCharge}</span>
        </div>
        <div class="col-12 d-flex justify-content-between py-1">
          <span class="text-muted"><i class="bi bi-receipt me-1"></i>GST (${gc}%):</span>
          <span class="text-info fw-semibold">+ ₹${gst}</span>
        </div>
        <hr class="my-2">
        <div class="col-12 d-flex justify-content-between py-1 bg-success bg-opacity-10 rounded px-2">
          <span class="fw-bold text-success"><i class="bi bi-person me-1"></i>Customer Pays:</span>
          <span class="fw-bold text-success">₹${total}</span>
        </div>
        <hr class="my-2">
        <div class="col-12 d-flex justify-content-between py-1">
          <span class="text-muted"><i class="bi bi-percent me-1"></i>Commission (${cc}%):</span>
          <span class="text-danger fw-semibold">- ₹${commission}</span>
        </div>
        <div class="col-12 d-flex justify-content-between py-1 bg-primary bg-opacity-10 rounded px-2">
          <span class="fw-bold text-primary"><i class="bi bi-shop me-1"></i>Vendor Gets:</span>
          <span class="fw-bold text-primary">₹${vendorPayout}</span>
        </div>
      </div>
    </div>`;
}
calcPreview();
</script>

<%- include('partials/footer') %>
