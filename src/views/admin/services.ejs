<%- include('partials/header') %>

<% if(success&&success.length){ %>
  <div class="alert alert-success alert-dismissible fade show">
    <i class="bi bi-check-circle-fill me-2"></i><%= success %>
    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
  </div>
<% } %>
<% if(error&&error.length){ %>
  <div class="alert alert-danger alert-dismissible fade show">
    <i class="bi bi-exclamation-triangle-fill me-2"></i><%= error %>
    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
  </div>
<% } %>

<div class="card border-0 shadow-sm">
  <div class="card-header bg-white border-bottom">
    <div class="d-flex flex-wrap gap-3 justify-content-between align-items-center">
      <div>
        <h5 class="mb-1 fw-bold text-dark"><i class="bi bi-tools me-2 text-primary"></i>Services Management</h5>
        <p class="text-muted small mb-0">Total: <span class="badge bg-primary"><%= total %></span> services</p>
      </div>
      <div class="d-flex gap-2 flex-wrap align-items-center">
        <form class="d-flex gap-2 align-items-center" method="GET">
          <div class="input-group input-group-sm">
            <span class="input-group-text bg-light border-end-0"><i class="bi bi-search text-muted"></i></span>
            <input type="text" name="search" class="form-control border-start-0" placeholder="Search services" value="<%= search %>" style="width:180px"/>
          </div>
          <button class="btn btn-outline-secondary btn-sm"><i class="bi bi-search"></i></button>
          <% if(search){ %>
            <a href="/admin/services" class="btn btn-outline-secondary btn-sm"><i class="bi bi-x-lg"></i></a>
          <% } %>
        </form>
        <button class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#addServiceModal">
          <i class="bi bi-plus-lg me-1"></i>Add Service
        </button>
      </div>
    </div>
  </div>

  <div class="table-responsive">
    <table class="table table-hover mb-0 align-middle">
      <thead class="table-light">
        <tr><th>#</th><th>Service</th><th>Category</th><th>Price</th><th>Discount</th><th>Final Price</th><th>Rating</th><th>Status</th><th>Actions</th></tr>
      </thead>
      <tbody>
      <% services.forEach((s, i) => { %>
        <tr>
          <td class="text-muted small fw-medium"><%= (currentPage-1)*15+i+1 %></td>
          <td>
            <div class="fw-semibold text-dark"><%= s.name %></div>
            <% if(s.estimated_time){ %>
              <small class="text-muted"><i class="bi bi-clock me-1"></i><%= s.estimated_time %></small>
            <% } %>
          </td>
          <td><span class="badge bg-light text-dark border"><%= s.Category?.name || '—' %></span></td>
          <td class="fw-bold text-dark">₹<%= parseFloat(s.price).toFixed(0) %></td>
          <td>
            <% if(parseFloat(s.discount_percent) > 0){ %>
              <span class="badge bg-danger"><%= s.discount_percent %>%</span>
            <% } else { %>
              <span class="text-muted">—</span>
            <% } %>
          </td>
          <td class="fw-bold text-success">₹<%= s.final_price ? parseFloat(s.final_price).toFixed(0) : parseFloat(s.price).toFixed(0) %></td>
          <td>
            <% if(parseFloat(s.rating) > 0){ %>
              <span class="text-warning"><i class="bi bi-star-fill"></i></span> <%= s.rating %> <small class="text-muted">(<%= s.rating_count %>)</small>
            <% } else { %>
              <span class="text-muted small">No ratings</span>
            <% } %>
          </td>
          <td>
            <span class="badge <%= s.is_active ? 'bg-success' : 'bg-secondary' %> rounded-pill">
              <%= s.is_active ? 'Active' : 'Inactive' %>
            </span>
          </td>
          <td>
            <div class="btn-group btn-group-sm">
              <a href="/admin/services/<%= s.id %>" class="btn btn-outline-primary" title="View"><i class="bi bi-eye"></i></a>
              <button class="btn btn-outline-secondary" title="Edit"
                data-bs-toggle="modal" data-bs-target="#editService<%= s.id %>">
                <i class="bi bi-pencil"></i>
              </button>
              <form method="POST" action="/admin/services/<%= s.id %>/toggle" class="d-inline">
                <button class="btn <%= s.is_active ? 'btn-outline-warning' : 'btn-outline-success' %>"
                  title="<%= s.is_active ? 'Disable' : 'Enable' %>">
                  <i class="bi <%= s.is_active ? 'bi-pause-circle' : 'bi-check-circle' %>"></i>
                </button>
              </form>
            </div>
          </td>
        </tr>

        <!-- Edit Modal -->
        <div class="modal fade" id="editService<%= s.id %>" tabindex="-1">
          <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow">
              <div class="modal-header">
                <h6 class="modal-title fw-semibold"><i class="bi bi-pencil text-primary me-2"></i>Edit Service</h6>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
              </div>
              <form method="POST" action="/admin/services/<%= s.id %>/update" enctype="multipart/form-data">
                <div class="modal-body">
                  <div class="mb-3">
                    <label class="form-label">Category <span class="text-danger">*</span></label>
                    <select name="category_id" class="form-select" required>
                      <% allCategories.forEach(c => { %>
                        <option value="<%= c.id %>" <%= s.category_id == c.id ? 'selected' : '' %>><%= c.name %></option>
                      <% }) %>
                    </select>
                  </div>
                  <div class="mb-3">
                    <label class="form-label">Name <span class="text-danger">*</span></label>
                    <input type="text" name="name" class="form-control" value="<%= s.name %>" required/>
                  </div>
                  <div class="mb-3">
                    <label class="form-label">Description</label>
                    <textarea name="description" class="form-control" rows="2"><%= s.description || '' %></textarea>
                  </div>
                  <div class="row g-2 mb-3">
                    <div class="col-6">
                      <label class="form-label">Price (₹) <span class="text-danger">*</span></label>
                      <input type="number" name="price" class="form-control svc-price" value="<%= s.price %>" step="0.01" required/>
                    </div>
                    <div class="col-6">
                      <label class="form-label">Discount (%)</label>
                      <input type="number" name="discount_percent" class="form-control svc-discount" value="<%= s.discount_percent || 0 %>" step="0.01" min="0" max="100"/>
                    </div>
                  </div>
                  <!-- Live Final Price Preview -->
                  <div class="mb-3 final-price-box" style="display:none;">
                    <div class="bg-success bg-opacity-10 border border-success border-opacity-25 rounded-3 p-3 d-flex align-items-center justify-content-between">
                      <div>
                        <small class="text-muted fw-medium">Final Price (after discount)</small>
                        <div class="d-flex align-items-center gap-2 mt-1">
                          <span class="text-decoration-line-through text-muted original-price-display"></span>
                          <span class="fw-bold text-success fs-5 final-price-display">₹0</span>
                          <span class="badge bg-danger discount-badge-display"></span>
                        </div>
                      </div>
                      <div class="text-success"><i class="bi bi-tag-fill" style="font-size:1.5rem;"></i></div>
                    </div>
                  </div>
                  <div class="mb-3">
                    <label class="form-label">Est. Time</label>
                    <input type="text" name="estimated_time" class="form-control" value="<%= s.estimated_time || '' %>" placeholder="e.g. 2 hours"/>
                  </div>
                  <% const faqArr = Array.isArray(s.faqs) ? s.faqs : (typeof s.faqs === 'string' ? JSON.parse(s.faqs || '[]') : []); %>
                  <div class="mb-3">
                    <label class="form-label">FAQs <small class="text-muted">(one per line: question | answer)</small></label>
                    <textarea name="faqs" class="form-control" rows="3" placeholder="How long does it take? | Usually 1-2 hours"><%= faqArr.map(f => f.question + ' | ' + f.answer).join('\n') %></textarea>
                  </div>
                  <% const incArr = Array.isArray(s.includes) ? s.includes : (typeof s.includes === 'string' ? JSON.parse(s.includes || '[]') : []); %>
                  <div class="mb-3">
                    <label class="form-label">Includes <small class="text-muted">(one item per line)</small></label>
                    <textarea name="includes" class="form-control" rows="3" placeholder="Deep cleaning of all rooms"><%= incArr.join('\n') %></textarea>
                  </div>
                  <% const howArr = Array.isArray(s.how_its_done) ? s.how_its_done : (typeof s.how_its_done === 'string' ? JSON.parse(s.how_its_done || '[]') : []); %>
                  <div class="mb-3">
                    <label class="form-label">How it's done? <small class="text-muted">(one step per line)</small></label>
                    <textarea name="how_its_done" class="form-control" rows="3" placeholder="Step 1: Inspection of area"><%= howArr.join('\n') %></textarea>
                  </div>
                  <% const excArr = Array.isArray(s.does_not_include) ? s.does_not_include : (typeof s.does_not_include === 'string' ? JSON.parse(s.does_not_include || '[]') : []); %>
                  <div class="mb-3">
                    <label class="form-label">Does not include <small class="text-muted">(one item per line)</small></label>
                    <textarea name="does_not_include" class="form-control" rows="3" placeholder="Ceiling cleaning"><%= excArr.join('\n') %></textarea>
                  </div>
                  <div class="mb-3">
                    <label class="form-label">Images <small class="text-muted">(leave empty to keep current)</small></label>
                    <input type="file" name="images" class="form-control" accept="image/*" multiple/>
                    <% const imgArr = Array.isArray(s.images) ? s.images : (typeof s.images === 'string' ? JSON.parse(s.images || '[]') : []); %>
                    <% if(imgArr.length){ %>
                      <div class="d-flex gap-1 flex-wrap mt-2">
                        <% imgArr.forEach(img => { %>
                          <img src="/uploads/<%= img %>" class="rounded" style="width:50px;height:50px;object-fit:cover"/>
                        <% }) %>
                      </div>
                    <% } %>
                  </div>
                  <div class="mb-2">
                    <label class="form-label">Status</label>
                    <select name="is_active" class="form-select">
                      <option value="1" <%= s.is_active ? 'selected' : '' %>>Active</option>
                      <option value="0" <%= !s.is_active ? 'selected' : '' %>>Inactive</option>
                    </select>
                  </div>
                </div>
                <div class="modal-footer">
                  <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                  <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg me-1"></i>Save</button>
                </div>
              </form>
            </div>
          </div>
        </div>
      <% }) %>
      <% if(!services.length){ %>
        <tr>
          <td colspan="9" class="text-center py-5 text-muted">
            <i class="bi bi-tools" style="font-size:2rem;"></i>
            <p class="mt-2 mb-0">No services found</p>
          </td>
        </tr>
      <% } %>
      </tbody>
    </table>
  </div>

  <% if(pages > 1){ %>
  <div class="card-footer d-flex justify-content-between align-items-center">
    <small class="text-muted">Showing <%= (currentPage-1)*15+1 %>–<%= Math.min(currentPage*15, total) %> of <%= total %></small>
    <nav><ul class="pagination pagination-sm mb-0">
      <% for(let p=1; p<=pages; p++){ %>
        <li class="page-item <%= p==currentPage?'active':'' %>">
          <a class="page-link" href="?page=<%= p %>&search=<%= search %>"><%= p %></a>
        </li>
      <% } %>
    </ul></nav>
  </div>
  <% } %>
</div>

<!-- Add Service Modal -->
<div class="modal fade" id="addServiceModal" tabindex="-1">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content border-0 shadow">
      <div class="modal-header">
        <h6 class="modal-title fw-semibold"><i class="bi bi-plus-circle text-primary me-2"></i>Add New Service</h6>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <form method="POST" action="/admin/services" enctype="multipart/form-data">
        <div class="modal-body">
          <div class="mb-3">
            <label class="form-label">Category <span class="text-danger">*</span></label>
            <select name="category_id" class="form-select" required>
              <option value="">— Select Category —</option>
              <% allCategories.forEach(c => { %>
                <option value="<%= c.id %>"><%= c.name %></option>
              <% }) %>
            </select>
          </div>
          <div class="mb-3">
            <label class="form-label">Name <span class="text-danger">*</span></label>
            <input type="text" name="name" class="form-control" placeholder="Service name" required/>
          </div>
          <div class="mb-3">
            <label class="form-label">Description</label>
            <textarea name="description" class="form-control" rows="2" placeholder="Short description"></textarea>
          </div>
          <div class="row g-2 mb-3">
            <div class="col-6">
              <label class="form-label">Price (₹) <span class="text-danger">*</span></label>
              <input type="number" name="price" class="form-control svc-price" placeholder="0.00" step="0.01" required/>
            </div>
            <div class="col-6">
              <label class="form-label">Discount (%)</label>
              <input type="number" name="discount_percent" class="form-control svc-discount" placeholder="0" step="0.01" min="0" max="100"/>
            </div>
          </div>
          <!-- Live Final Price Preview -->
          <div class="mb-3 final-price-box" style="display:none;">
            <div class="bg-success bg-opacity-10 border border-success border-opacity-25 rounded-3 p-3 d-flex align-items-center justify-content-between">
              <div>
                <small class="text-muted fw-medium">Final Price (after discount)</small>
                <div class="d-flex align-items-center gap-2 mt-1">
                  <span class="text-decoration-line-through text-muted original-price-display"></span>
                  <span class="fw-bold text-success fs-5 final-price-display">₹0</span>
                  <span class="badge bg-danger discount-badge-display"></span>
                </div>
              </div>
              <div class="text-success"><i class="bi bi-tag-fill" style="font-size:1.5rem;"></i></div>
            </div>
          </div>
          <div class="mb-3">
            <label class="form-label">Est. Time</label>
            <input type="text" name="estimated_time" class="form-control" placeholder="e.g. 2 hours"/>
          </div>
          <div class="mb-3">
            <label class="form-label">Images <small class="text-muted">(optional, max 10)</small></label>
            <input type="file" name="images" class="form-control" accept="image/*" multiple/>
          </div>
          <div class="mb-3">
            <label class="form-label">Includes <small class="text-muted">(one item per line)</small></label>
            <textarea name="includes" class="form-control" rows="3" placeholder="Deep cleaning of all rooms&#10;Bathroom sanitization&#10;Kitchen cleaning"></textarea>
          </div>
          <div class="mb-3">
            <label class="form-label">How it's done? <small class="text-muted">(one step per line)</small></label>
            <textarea name="how_its_done" class="form-control" rows="3" placeholder="Step 1: Inspection of area&#10;Step 2: Cleaning with equipment&#10;Step 3: Final check"></textarea>
          </div>
          <div class="mb-3">
            <label class="form-label">Does not include <small class="text-muted">(one item per line)</small></label>
            <textarea name="does_not_include" class="form-control" rows="3" placeholder="Ceiling cleaning&#10;Outdoor areas&#10;Heavy furniture moving"></textarea>
          </div>
          <div class="mb-2">
            <label class="form-label">FAQs <small class="text-muted">(one per line: question | answer)</small></label>
            <textarea name="faqs" class="form-control" rows="3" placeholder="How long does it take? | Usually 1-2 hours&#10;Do I need tools? | No, we bring everything"></textarea>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-primary"><i class="bi bi-plus-lg me-1"></i>Add Service</button>
        </div>
      </form>
    </div>
  </div>
</div>

<%- include('partials/footer') %>

<script>
// Live Final Price Calculator
function initPriceCalculators() {
  document.querySelectorAll('form').forEach(form => {
    const priceInput = form.querySelector('.svc-price');
    const discountInput = form.querySelector('.svc-discount');
    const box = form.querySelector('.final-price-box');
    if (!priceInput || !discountInput || !box) return;

    const originalDisplay = box.querySelector('.original-price-display');
    const finalDisplay = box.querySelector('.final-price-display');
    const badgeDisplay = box.querySelector('.discount-badge-display');

    function calculate() {
      const price = parseFloat(priceInput.value) || 0;
      const discount = parseFloat(discountInput.value) || 0;

      if (price > 0 && discount > 0) {
        const finalPrice = price - (price * discount / 100);
        const saved = price - finalPrice;
        originalDisplay.textContent = '₹' + price.toFixed(0);
        finalDisplay.textContent = '₹' + finalPrice.toFixed(2);
        badgeDisplay.textContent = discount + '% OFF (Save ₹' + saved.toFixed(0) + ')';
        box.style.display = 'block';
      } else if (price > 0 && discount === 0) {
        box.style.display = 'none';
      } else {
        box.style.display = 'none';
      }
    }

    priceInput.addEventListener('input', calculate);
    discountInput.addEventListener('input', calculate);
    // Trigger on modal open for edit modals
    calculate();
  });
}

// Init on page load
initPriceCalculators();

// Re-init when modals open (for edit modals with pre-filled values)
document.querySelectorAll('.modal').forEach(modal => {
  modal.addEventListener('shown.bs.modal', initPriceCalculators);
});
</script>
