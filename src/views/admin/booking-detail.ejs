<%- include('partials/header') %>

<% const sc={pending:'warning',accepted:'info',in_progress:'primary',completed:'success',cancelled:'danger'}; %>
<% const pc={pending:'secondary',paid:'success',refunded:'warning'}; %>

<!-- Top Bar -->
<div class="d-flex align-items-center justify-content-between flex-wrap gap-3 mb-4">
  <a href="/admin/bookings" class="btn btn-sm btn-light">
    <i class="bi bi-arrow-left me-1"></i>Back to Bookings
  </a>

  <!-- Status Change -->
  <form method="POST" action="/admin/bookings/<%= booking.id %>/update-status" class="d-flex align-items-center gap-2">
    <span class="text-muted small fw-medium">Change Status:</span>
    <div class="d-flex gap-1 flex-wrap">
      <% ['pending','accepted','in_progress','completed','cancelled'].forEach(s => { %>
        <button type="submit" name="status" value="<%= s %>"
          class="btn btn-sm <%= booking.status === s ? 'btn-'+sc[s] : 'btn-outline-'+sc[s] %>"
          style="border-radius:20px;font-size:.75rem;"
          <%= booking.status === s ? 'disabled' : '' %>>
          <% if(s==='pending'){ %><i class="bi bi-clock-history me-1"></i>
          <% } else if(s==='accepted'){ %><i class="bi bi-check-circle me-1"></i>
          <% } else if(s==='in_progress'){ %><i class="bi bi-arrow-repeat me-1"></i>
          <% } else if(s==='completed'){ %><i class="bi bi-check-circle-fill me-1"></i>
          <% } else if(s==='cancelled'){ %><i class="bi bi-x-circle me-1"></i><% } %>
          <%= s.replace('_',' ') %>
        </button>
      <% }) %>
    </div>
  </form>
</div>

<div class="row g-3">

  <!-- Booking Info -->
  <div class="col-lg-8">
    <div class="card mb-3">
      <div class="card-header d-flex justify-content-between align-items-center">
        <span><i class="bi bi-calendar-check me-2 text-primary"></i>Booking #<%= booking.id %></span>
        <div class="d-flex gap-2">
          <span class="badge bg-<%= sc[booking.status]||'secondary' %> rounded-pill"><%= booking.status %></span>
          <span class="badge bg-<%= pc[booking.payment_status]||'secondary' %> rounded-pill"><%= booking.payment_status %></span>
        </div>
      </div>
      <div class="card-body">
        <div class="row g-3">
          <div class="col-sm-6">
            <p class="text-muted small mb-1">Service</p>
            <p class="fw-semibold mb-0"><%= booking.Service?.name || '—' %></p>
            <% if(booking.Service?.description){ %>
              <small class="text-muted"><%= booking.Service.description %></small>
            <% } %>
            <% if(booking.Service?.estimated_time){ %>
              <div class="mt-1"><small class="text-muted"><i class="bi bi-clock me-1"></i><%= booking.Service.estimated_time %></small></div>
            <% } %>
          </div>
          <div class="col-sm-6">
            <p class="text-muted small mb-1">Booking Date</p>
            <p class="fw-semibold mb-0"><i class="bi bi-calendar3 me-1 text-primary"></i><%= formatDate(booking.booking_date) %></p>
          </div>
          <% if(booking.Slot){ %>
          <div class="col-sm-6">
            <p class="text-muted small mb-1">Time Slot</p>
            <p class="fw-semibold mb-0">
              <i class="bi bi-clock me-1 text-success"></i><%= booking.Slot.start_time %> - <%= booking.Slot.end_time %>
              <small class="text-muted ms-1">(<%= new Date(booking.Slot.date).toLocaleDateString('en-IN', { day:'2-digit', month:'short' }) %>)</small>
            </p>
          </div>
          <% } %>
          <div class="col-12">
            <p class="text-muted small mb-1">Service Address</p>
            <p class="fw-semibold mb-0"><i class="bi bi-geo-alt me-1 text-danger"></i><%= booking.address || '—' %></p>
          </div>
          <% if(booking.notes){ %>
          <div class="col-12">
            <p class="text-muted small mb-1">Customer Notes</p>
            <div class="bg-light rounded p-2 small"><%= booking.notes %></div>
          </div>
          <% } %>
        </div>
      </div>
    </div>

    <!-- Chat Messages -->
    <div class="card">
      <div class="card-header">
        <i class="bi bi-chat-dots me-2 text-primary"></i>Chat Messages
        <span class="badge bg-secondary ms-1"><%= messages.length %></span>
      </div>
      <div class="card-body p-0">
        <% if(messages.length){ %>
          <div style="max-height:420px;overflow-y:auto;padding:16px;" id="chatBox">
            <% messages.forEach(m => { %>
              <% const sender = senderMap[m.sender_id]; %>
              <% const isVendor = sender?.role === 'vendor'; %>
              <div class="d-flex mb-3 <%= isVendor ? 'flex-row-reverse' : '' %>">
                <div class="rounded-circle bg-<%= isVendor ? 'success' : 'primary' %> bg-opacity-10 d-flex align-items-center justify-content-center flex-shrink-0"
                     style="width:34px;height:34px;">
                  <i class="bi bi-<%= isVendor ? 'shop' : 'person-fill' %> text-<%= isVendor ? 'success' : 'primary' %>" style="font-size:14px;"></i>
                </div>
                <div class="mx-2" style="max-width:70%;">
                  <div class="small text-muted mb-1 <%= isVendor ? 'text-end' : '' %>">
                    <%= sender?.name || 'User #'+m.sender_id %>
                    <span class="ms-1"><%= new Date(m.created_at).toLocaleString('en-IN',{day:'2-digit',month:'short',hour:'2-digit',minute:'2-digit'}) %></span>
                    <% if(m.is_read){ %><i class="bi bi-check2-all text-primary ms-1"></i><% } %>
                  </div>
                  <div class="rounded-3 px-3 py-2 small
                    <%= isVendor ? 'bg-success bg-opacity-10 text-dark' : 'bg-primary bg-opacity-10 text-dark' %>">
                    <%= m.message %>
                  </div>
                </div>
              </div>
            <% }) %>
          </div>
        <% } else { %>
          <div class="text-center py-4 text-muted">
            <i class="bi bi-chat-dots" style="font-size:2rem;"></i>
            <p class="mt-2 mb-0 small">No messages yet</p>
          </div>
        <% } %>
      </div>
    </div>
  </div>

  <!-- Sidebar: Customer, Vendor, Pricing -->
  <div class="col-lg-4">

    <!-- Customer -->
    <div class="card mb-3">
      <div class="card-header"><i class="bi bi-person-fill me-2 text-primary"></i>Customer</div>
      <div class="card-body">
        <p class="fw-semibold mb-1"><%= booking.User?.name || '—' %></p>
        <p class="text-muted small mb-1"><i class="bi bi-phone me-1"></i><%= booking.User?.mobile || '—' %></p>
        <% if(booking.User?.email){ %>
          <p class="text-muted small mb-0"><i class="bi bi-envelope me-1"></i><%= booking.User.email %></p>
        <% } %>
      </div>
    </div>

    <!-- Worker Assignment -->
    <div class="card mb-3">
      <div class="card-header"><i class="bi bi-person-badge-fill me-2 text-warning"></i>Assigned Worker</div>
      <div class="card-body">
        <% if(booking.Worker){ %>
          <p class="fw-semibold mb-1"><i class="bi bi-person-check-fill text-success me-1"></i><%= booking.Worker.name %></p>
          <p class="text-muted small mb-2"><i class="bi bi-phone me-1"></i><%= booking.Worker.phone %></p>
          <a href="/admin/workers/<%= booking.Worker.id %>" class="btn btn-sm btn-outline-primary">View Worker</a>
        <% } else { %>
          <p class="text-muted small mb-2">No worker assigned yet</p>
        <% } %>
        <% if(booking.status !== 'completed' && booking.status !== 'cancelled'){ %>
          <form method="POST" action="/admin/bookings/<%= booking.id %>/assign-worker" class="mt-2">
            <div class="input-group input-group-sm">
              <select name="worker_id" class="form-select" required>
                <option value="">— Select Worker —</option>
                <% availableWorkers.forEach(w => { %>
                  <option value="<%= w.id %>" <%= booking.worker_id == w.id ? 'selected' : '' %>><%= w.name %> (<%= w.phone %>)</option>
                <% }) %>
              </select>
              <button class="btn btn-warning" type="submit"><i class="bi bi-person-check-fill"></i> Assign</button>
            </div>
          </form>
        <% } %>
      </div>
    </div>

    <!-- Payment Info -->
    <div class="card mb-3">
      <div class="card-header"><i class="bi bi-cash-coin me-2 text-success"></i>Payment</div>
      <div class="card-body p-0">
        <table class="table table-sm mb-0">
          <tbody>
            <tr>
              <td class="text-muted">Method</td>
              <td>
                <% if(booking.payment_method === 'cod'){ %>
                  <span class="badge bg-warning text-dark"><i class="bi bi-cash me-1"></i>Cash on Delivery</span>
                <% } else { %>
                  <span class="badge bg-info"><i class="bi bi-credit-card me-1"></i>Online</span>
                <% } %>
              </td>
            </tr>
            <tr><td class="text-muted">Payment Status</td><td><span class="badge bg-<%= booking.payment_status==='paid'?'success':booking.payment_status==='refunded'?'warning':'secondary' %>"><%= booking.payment_status %></span></td></tr>
            <% if(booking.payment_method === 'cod'){ %>
              <tr><td class="text-muted">COD Collected</td><td class="fw-semibold text-success">₹<%= parseFloat(booking.cod_collected||0).toFixed(2) %></td></tr>
              <tr><td class="text-muted">Admin Due</td><td class="fw-semibold text-danger">₹<%= parseFloat(booking.admin_due||0).toFixed(2) %></td></tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>

    <!-- Pricing Breakdown -->
    <div class="card">
      <div class="card-header"><i class="bi bi-receipt me-2 text-warning"></i>Pricing Breakdown</div>
      <div class="card-body p-0">
        <table class="table table-sm mb-0">
          <tbody>
            <tr><td class="text-muted">Base Amount</td><td class="text-end fw-medium">₹<%= parseFloat(booking.amount||0).toFixed(2) %></td></tr>
            <tr><td class="text-muted">Platform Charge</td><td class="text-end">₹<%= parseFloat(booking.platform_charge||0).toFixed(2) %></td></tr>
            <tr><td class="text-muted">GST</td><td class="text-end">₹<%= parseFloat(booking.gst_amount||0).toFixed(2) %></td></tr>
            <tr class="table-light"><td class="fw-bold">Total</td><td class="text-end fw-bold text-primary">₹<%= parseFloat(booking.total_amount||0).toFixed(2) %></td></tr>

          </tbody>
        </table>
      </div>
    </div>

  </div>
</div>

<script>
  const cb = document.getElementById('chatBox');
  if(cb) cb.scrollTop = cb.scrollHeight;
</script>

<%- include('partials/footer') %>
