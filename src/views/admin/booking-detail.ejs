<%- include('partials/header') %>

<% const sc={pending:'warning',accepted:'info',in_progress:'primary',completed:'success',cancelled:'danger'}; %>
<% const pc={pending:'secondary',paid:'success',refunded:'warning'}; %>

<% if(success&&success.length){ %>
  <div class="alert alert-success alert-dismissible fade show" role="alert">
    <i class="bi bi-check-circle-fill me-2"></i><%= success %>
    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
  </div>
<% } %>
<% if(error&&error.length){ %>
  <div class="alert alert-danger alert-dismissible fade show" role="alert">
    <i class="bi bi-exclamation-triangle-fill me-2"></i><%= error %>
    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
  </div>
<% } %>

<!-- Top Bar -->
<div class="d-flex align-items-center justify-content-between flex-wrap gap-3 mb-4">
  <div class="d-flex align-items-center gap-3">
    <a href="/admin/bookings" class="btn btn-sm btn-light">
      <i class="bi bi-arrow-left me-1"></i>Back
    </a>
    <div>
      <h5 class="mb-0 fw-bold">Booking #<%= booking.id %></h5>
      <small class="text-muted">Created <%= new Date(booking.createdAt).toLocaleDateString('en-IN', { day:'2-digit', month:'short', year:'numeric', hour:'2-digit', minute:'2-digit' }) %></small>
    </div>
  </div>
  <div class="d-flex gap-2">
    <span class="badge bg-<%= sc[booking.status]||'secondary' %> rounded-pill px-3 py-2" style="font-size:.8rem;">
      <i class="bi bi-circle-fill me-1" style="font-size:6px;"></i><%= booking.status.replace('_',' ').toUpperCase() %>
    </span>
    <span class="badge bg-<%= pc[booking.payment_status]||'secondary' %> rounded-pill px-3 py-2" style="font-size:.8rem;">
      ₹ <%= booking.payment_status.toUpperCase() %>
    </span>
  </div>
</div>

<div class="row g-4">

  <!-- Left Column -->
  <div class="col-lg-8">

    <!-- Service Details Card -->
    <div class="card mb-4">
      <div class="card-header">
        <i class="bi bi-tools me-2 text-primary"></i>Service Details
      </div>
      <div class="card-body">
        <div class="d-flex gap-3">
          <% 
            let serviceImages = [];
            if(booking.Service && booking.Service.images) {
              serviceImages = Array.isArray(booking.Service.images) ? booking.Service.images : (typeof booking.Service.images === 'string' ? JSON.parse(booking.Service.images || '[]') : []);
            }
          %>
          <% if(serviceImages.length){ %>
            <img src="/uploads/<%= serviceImages[0] %>" class="rounded" style="width:80px;height:80px;object-fit:cover;" alt="Service"/>
          <% } else { %>
            <div class="bg-primary bg-opacity-10 rounded d-flex align-items-center justify-content-center" style="width:80px;height:80px;">
              <i class="bi bi-tools text-primary" style="font-size:1.8rem;"></i>
            </div>
          <% } %>
          <div class="flex-grow-1">
            <h6 class="fw-bold mb-1"><%= (booking.Service && booking.Service.name) ? booking.Service.name : '—' %></h6>
            <% if(booking.Service && booking.Service.Category){ %>
              <span class="badge bg-primary bg-opacity-10 text-primary mb-2"><%= booking.Service.Category.name %></span>
            <% } %>
            <% if(booking.Service && booking.Service.description){ %>
              <p class="text-muted small mb-1"><%= booking.Service.description %></p>
            <% } %>
            <% if(booking.Service && booking.Service.estimated_time){ %>
              <small class="text-muted"><i class="bi bi-clock me-1"></i>Est. Time: <%= booking.Service.estimated_time %></small>
            <% } %>
          </div>
          <div class="text-end">
            <p class="fw-bold text-primary mb-0" style="font-size:1.1rem;">₹<%= parseFloat(booking.amount||0).toFixed(2) %></p>
            <small class="text-muted">Service Price</small>
          </div>
        </div>
      </div>
    </div>

    <!-- Schedule & Address Card -->
    <div class="card mb-4">
      <div class="card-header">
        <i class="bi bi-calendar-event me-2 text-success"></i>Schedule & Location
      </div>
      <div class="card-body">
        <div class="row g-4">
          <!-- Booking Date -->
          <div class="col-sm-6">
            <div class="d-flex align-items-start gap-3">
              <div class="bg-warning bg-opacity-10 rounded-3 d-flex align-items-center justify-content-center flex-shrink-0" style="width:44px;height:44px;">
                <i class="bi bi-calendar3 text-warning"></i>
              </div>
              <div>
                <p class="text-muted small mb-0">Booking Date</p>
                <p class="fw-semibold mb-0"><%= new Date(booking.booking_date).toLocaleDateString('en-IN', { weekday:'short', day:'2-digit', month:'short', year:'numeric' }) %></p>
              </div>
            </div>
          </div>

          <!-- Confirmation OTP -->
          <div class="col-sm-6">
            <div class="d-flex align-items-start gap-3">
              <div class="bg-success bg-opacity-10 rounded-3 d-flex align-items-center justify-content-center flex-shrink-0" style="width:44px;height:44px;">
                <i class="bi bi-key text-success"></i>
              </div>
              <div>
                <p class="text-muted small mb-0">Confirmation OTP</p>
                <p class="fw-bold mb-0" style="font-size:1.2rem;letter-spacing:3px;"><%= booking.confirmation_otp || '—' %></p>
                <small class="text-muted">Worker needs this to complete</small>
              </div>
            </div>
          </div>

          <!-- Address -->
          <div class="col-12">
            <div class="d-flex align-items-start gap-3">
              <div class="bg-danger bg-opacity-10 rounded-3 d-flex align-items-center justify-content-center flex-shrink-0" style="width:44px;height:44px;">
                <i class="bi bi-geo-alt-fill text-danger"></i>
              </div>
              <div>
                <p class="text-muted small mb-0">Service Address</p>
                <% if(booking.Address){ %>
                  <p class="fw-semibold mb-0">
                    <span class="badge bg-light text-dark border me-1" style="font-size:.7rem;"><%= booking.Address.label %></span>
                    <%= booking.Address.full_address %>
                  </p>
                  <div class="mt-1">
                    <% if(booking.Address.landmark){ %>
                      <small class="text-muted me-3"><i class="bi bi-signpost me-1"></i>Landmark: <%= booking.Address.landmark %></small>
                    <% } %>
                    <% if(booking.Address.city){ %>
                      <small class="text-muted me-3"><i class="bi bi-building me-1"></i><%= booking.Address.city %></small>
                    <% } %>
                    <% if(booking.Address.state){ %>
                      <small class="text-muted me-3"><%= booking.Address.state %></small>
                    <% } %>
                    <% if(booking.Address.pincode){ %>
                      <small class="text-muted"><i class="bi bi-mailbox me-1"></i><%= booking.Address.pincode %></small>
                    <% } %>
                  </div>
                <% } else { %>
                  <p class="fw-semibold mb-0"><%= booking.address || '—' %></p>
                <% } %>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Customer Notes -->
    <% if(booking.notes){ %>
    <div class="card mb-4">
      <div class="card-header">
        <i class="bi bi-sticky me-2 text-info"></i>Customer Notes
      </div>
      <div class="card-body">
        <p class="mb-0"><%= booking.notes %></p>
      </div>
    </div>
    <% } %>

    <!-- Status Change -->
    <div class="card mb-4">
      <div class="card-header">
        <i class="bi bi-arrow-repeat me-2 text-primary"></i>Update Status
      </div>
      <div class="card-body">
        <form method="POST" action="/admin/bookings/<%= booking.id %>/update-status">
          <div class="d-flex gap-2 flex-wrap">
            <% ['pending','accepted','in_progress','completed','cancelled'].forEach(s => { %>
              <button type="submit" name="status" value="<%= s %>"
                class="btn btn-sm <%= booking.status === s ? 'btn-'+sc[s] : 'btn-outline-'+sc[s] %>"
                style="border-radius:20px;"
                <%= booking.status === s ? 'disabled' : '' %>>
                <% if(s==='pending'){ %><i class="bi bi-clock-history me-1"></i>
                <% } else if(s==='accepted'){ %><i class="bi bi-check-circle me-1"></i>
                <% } else if(s==='in_progress'){ %><i class="bi bi-arrow-repeat me-1"></i>
                <% } else if(s==='completed'){ %><i class="bi bi-check-circle-fill me-1"></i>
                <% } else if(s==='cancelled'){ %><i class="bi bi-x-circle me-1"></i><% } %>
                <%= s.replace('_',' ') %>
              </button>
            <% }) %>
          </div>
        </form>
      </div>
    </div>

    <!-- Chat Messages -->
    <div class="card">
      <div class="card-header">
        <i class="bi bi-chat-dots me-2 text-primary"></i>Chat Messages
        <span class="badge bg-secondary ms-1"><%= messages.length %></span>
      </div>
      <div class="card-body p-0">
        <% if(messages.length){ %>
          <div style="max-height:400px;overflow-y:auto;padding:16px;" id="chatBox">
            <% messages.forEach(m => { %>
              <% const sender = senderMap[m.sender_id]; %>
              <% const isVendor = sender?.role === 'vendor'; %>
              <div class="d-flex mb-3 <%= isVendor ? 'flex-row-reverse' : '' %>">
                <div class="rounded-circle bg-<%= isVendor ? 'success' : 'primary' %> bg-opacity-10 d-flex align-items-center justify-content-center flex-shrink-0"
                     style="width:34px;height:34px;">
                  <i class="bi bi-<%= isVendor ? 'shop' : 'person-fill' %> text-<%= isVendor ? 'success' : 'primary' %>" style="font-size:14px;"></i>
                </div>
                <div class="mx-2" style="max-width:70%;">
                  <div class="small text-muted mb-1 <%= isVendor ? 'text-end' : '' %>">
                    <%= sender?.name || 'User #'+m.sender_id %>
                    <span class="ms-1"><%= new Date(m.created_at).toLocaleString('en-IN',{day:'2-digit',month:'short',hour:'2-digit',minute:'2-digit'}) %></span>
                    <% if(m.is_read){ %><i class="bi bi-check2-all text-primary ms-1"></i><% } %>
                  </div>
                  <div class="rounded-3 px-3 py-2 small
                    <%= isVendor ? 'bg-success bg-opacity-10 text-dark' : 'bg-primary bg-opacity-10 text-dark' %>">
                    <%= m.message %>
                  </div>
                </div>
              </div>
            <% }) %>
          </div>
        <% } else { %>
          <div class="text-center py-4 text-muted">
            <i class="bi bi-chat-dots" style="font-size:2rem;"></i>
            <p class="mt-2 mb-0 small">No messages yet</p>
          </div>
        <% } %>
      </div>
    </div>

  </div>

  <!-- Right Column -->
  <div class="col-lg-4">

    <!-- Customer Card -->
    <div class="card mb-4">
      <div class="card-header"><i class="bi bi-person-fill me-2 text-primary"></i>Customer</div>
      <div class="card-body">
        <div class="d-flex align-items-center gap-3 mb-3">
          <div class="bg-primary bg-opacity-10 rounded-circle d-flex align-items-center justify-content-center" style="width:48px;height:48px;">
            <span class="fw-bold text-primary" style="font-size:1.1rem;"><%= (booking.User && booking.User.name) ? booking.User.name[0].toUpperCase() : 'U' %></span>
          </div>
          <div>
            <p class="fw-semibold mb-0"><%= (booking.User && booking.User.name) ? booking.User.name : '—' %></p>
            <small class="text-muted">Customer</small>
          </div>
        </div>
        <div class="d-flex flex-column gap-2">
          <div class="d-flex align-items-center gap-2">
            <i class="bi bi-phone text-muted"></i>
            <span class="small"><%= (booking.User && booking.User.mobile) ? booking.User.mobile : '—' %></span>
          </div>
          <% if(booking.User && booking.User.email){ %>
          <div class="d-flex align-items-center gap-2">
            <i class="bi bi-envelope text-muted"></i>
            <span class="small"><%= booking.User.email %></span>
          </div>
          <% } %>
        </div>
      </div>
    </div>

    <!-- Worker Info -->
    <div class="card mb-4">
      <div class="card-header"><i class="bi bi-person-badge-fill me-2 text-warning"></i>Assigned Worker</div>
      <div class="card-body">
        <% if(booking.Worker){ %>
          <div class="d-flex align-items-center gap-3">
            <div class="bg-success bg-opacity-10 rounded-circle d-flex align-items-center justify-content-center" style="width:44px;height:44px;">
              <i class="bi bi-person-check-fill text-success"></i>
            </div>
            <div>
              <p class="fw-semibold mb-0"><%= booking.Worker.name %></p>
              <small class="text-muted"><i class="bi bi-phone me-1"></i><%= booking.Worker.phone %></small>
            </div>
          </div>
          <a href="/admin/workers/<%= booking.Worker.id %>" class="btn btn-sm btn-outline-primary w-100 mt-3">
            <i class="bi bi-eye me-1"></i>View Worker Profile
          </a>
        <% } else { %>
          <div class="text-center py-3">
            <i class="bi bi-hourglass-split text-warning" style="font-size:1.5rem;"></i>
            <p class="text-muted small mt-2 mb-0">Waiting for worker to accept</p>
          </div>
        <% } %>
      </div>
    </div>

    <!-- Payment Info -->
    <div class="card mb-4">
      <div class="card-header"><i class="bi bi-credit-card me-2 text-info"></i>Payment Info</div>
      <div class="card-body p-0">
        <table class="table table-sm mb-0">
          <tbody>
            <tr>
              <td class="text-muted ps-3">Method</td>
              <td class="text-end pe-3">
                <% if(booking.payment_method === 'cod'){ %>
                  <span class="badge bg-warning text-dark"><i class="bi bi-cash me-1"></i>COD</span>
                <% } else { %>
                  <span class="badge bg-info"><i class="bi bi-credit-card me-1"></i>Online</span>
                <% } %>
              </td>
            </tr>
            <tr>
              <td class="text-muted ps-3">Status</td>
              <td class="text-end pe-3">
                <span class="badge bg-<%= pc[booking.payment_status]||'secondary' %>"><%= booking.payment_status %></span>
              </td>
            </tr>
            <% if(booking.payment_id){ %>
            <tr>
              <td class="text-muted ps-3">Payment ID</td>
              <td class="text-end pe-3"><small class="font-monospace"><%= booking.payment_id %></small></td>
            </tr>
            <% } %>
            <% if(booking.payment_method === 'cod'){ %>
            <tr>
              <td class="text-muted ps-3">COD Collected</td>
              <td class="text-end pe-3 fw-semibold text-success">₹<%= parseFloat(booking.cod_collected||0).toFixed(2) %></td>
            </tr>
            <tr>
              <td class="text-muted ps-3">Admin Due</td>
              <td class="text-end pe-3 fw-semibold text-danger">₹<%= parseFloat(booking.admin_due||0).toFixed(2) %></td>
            </tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>

    <!-- Pricing Breakdown -->
    <div class="card">
      <div class="card-header"><i class="bi bi-receipt me-2 text-warning"></i>Pricing Breakdown</div>
      <div class="card-body p-0">
        <table class="table table-sm mb-0">
          <tbody>
            <tr>
              <td class="text-muted ps-3">Service Amount</td>
              <td class="text-end pe-3 fw-medium">₹<%= parseFloat(booking.amount||0).toFixed(2) %></td>
            </tr>
            <% if(booking.coupon_discount && parseFloat(booking.coupon_discount) > 0){ %>
            <tr class="table-success">
              <td class="ps-3">
                <span class="text-success fw-medium">
                  <i class="bi bi-ticket-perforated me-1"></i>Coupon
                  <% if(booking.Coupon){ %>
                    (<%= booking.Coupon.code %>)
                  <% } else if(booking.coupon_code){ %>
                    (<%= booking.coupon_code %>)
                  <% } %>
                </span>
              </td>
              <td class="text-end pe-3 fw-bold text-success">-₹<%= parseFloat(booking.coupon_discount).toFixed(2) %></td>
            </tr>
            <% } %>
            <tr>
              <td class="text-muted ps-3">Platform Charge</td>
              <td class="text-end pe-3">₹<%= parseFloat(booking.platform_charge||0).toFixed(2) %></td>
            </tr>
            <tr>
              <td class="text-muted ps-3">GST</td>
              <td class="text-end pe-3">₹<%= parseFloat(booking.gst_amount||0).toFixed(2) %></td>
            </tr>
            <tr class="border-top">
              <td class="ps-3 fw-bold py-2">Total Amount</td>
              <td class="text-end pe-3 fw-bold text-primary py-2" style="font-size:1.1rem;">₹<%= parseFloat(booking.total_amount||0).toFixed(2) %></td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>

  </div>
</div>

<script>
  const cb = document.getElementById('chatBox');
  if(cb) cb.scrollTop = cb.scrollHeight;
</script>

<%- include('partials/footer') %>
